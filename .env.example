# Supabase / backend environment (never commit real values).
# Copy to .env for local development. Vercel project settings hold production values.

# Public (safe for the browser bundle; RLS still applies)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel env + local .env; NEVER prefix with PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 10+ (inquiry delivery + spam protection; not required until then)
# TURNSTILE_SECRET_KEY=
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=
