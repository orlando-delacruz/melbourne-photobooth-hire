---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingMessenger from "../components/FloatingMessenger.astro";
import StructuredData from "../components/StructuredData.astro";
import { getContent } from "../lib/content/repository";
import { loadPublicPages } from "../lib/supabase/public";
import { NAV_ITEMS } from "../lib/navigation";
import "@fontsource/fraunces/latin-400.css";
import "@fontsource/fraunces/latin-400-italic.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/fraunces/latin-600-italic.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/mobile-nav.css";
import "../styles/gallery-lightbox.css";

interface Props {
  title: string;
  description: string;
  /** Extra class on <body>, e.g. "page-home" for a full-bleed dark canvas. */
  bodyClass?: string;
  /** URL to preload (LCP image), homepage hero background. */
  preloadImage?: string;
  /** Social share image; defaults to the hero background image. */
  ogImage?: string;
  /** Alt text for the social share image; defaults to the brand or hero alt. */
  ogImageAlt?: string;
  /** Absolute-URL canonical override; defaults to the page URL. */
  canonicalUrl?: string;
  /** Keep a page out of search results (for example the 404 page). */
  noindex?: boolean;
  /** Keep crawlers from following this page's links. */
  nofollow?: boolean;
  /** OG overrides; default to the page title and description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Extra Schema.org nodes for this page, rendered alongside the site graph. */
  structuredData?: Record<string, unknown>[];
}
const {
  title,
  description,
  bodyClass = "",
  preloadImage,
  ogImage,
  ogImageAlt,
  canonicalUrl: canonicalOverride,
  noindex = false,
  nofollow = false,
  ogTitle,
  ogDescription,
  structuredData = [],
} = Astro.props;
const { site, heroBackgroundImage } = getContent();
// Site chrome (brand, footer, messenger) reads the CMS settings blob so the
// Site Settings admin is real; hero imagery keeps its mock source for now.
const { settings: siteSettings } = await loadPublicPages();
const brandName = siteSettings.brandName || site.brandName;
const serviceAreaStatement = siteSettings.serviceAreaStatement || site.serviceAreaStatement;
const reviewUrl = siteSettings.reviewUrl || null;
// CMS social profiles (Site Settings). Empty until the client saves real
// profile URLs, so both the footer/contact blocks and sameAs stay hidden.
const socials = siteSettings.socials ?? [];
const currentPath = Astro.url.pathname;

const siteOrigin = (Astro.site ?? new URL("https://melbournephotoboothhire.com.au")).origin;
// Canonical URLs are normalised without a trailing slash (root keeps "/"),
// unless the SEO module sets an absolute-URL override for the page.
const canonicalPath = currentPath.replace(/\/+$/, "") || "/";
const canonicalUrl = canonicalOverride ?? new URL(canonicalPath, siteOrigin).href;

const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;

const socialImageSrc = ogImage ?? heroBackgroundImage?.src;
const socialImage = socialImageSrc ? new URL(socialImageSrc, canonicalUrl).href : undefined;
const socialImageAlt =
  ogImage && ogImageAlt ? ogImageAlt : ogImage ? brandName : heroBackgroundImage?.alt;

// Google Search Console URL-prefix verification. The token is public and must
// appear in the served HTML; the env value can override it per environment.
const googleVerification =
  (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined) ??
  "HemkyvmWRx4jOA7etp5IrpO5f0UIdf3jQhkP_38mvkQ";

/**
 * Site-wide structured data.
 *
 * Only confirmed facts are emitted: brand, production URL and Melbourne
 * service area, plus CMS-saved social profile URLs (sameAs) once the client
 * provides them. Address, phone and service/price detail are deliberately
 * omitted until the client confirms them (DEC-016).
 */
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: brandName,
      url: `${siteOrigin}/`,
      description:
        "Photobooth hire for weddings, birthdays, corporate events and celebrations across Melbourne, Victoria.",
      areaServed: { "@type": "City", name: "Melbourne" },
      ...(socials.length > 0 ? { sameAs: socials.map((social) => social.url) } : {}),
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      url: `${siteOrigin}/`,
      name: brandName,
      inLanguage: "en-AU",
      publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "en-AU",
      isPartOf: { "@id": `${siteOrigin}/#website` },
      about: { "@id": `${siteOrigin}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17120c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? `noindex, ${nofollow ? "nofollow" : "follow"}`
          : `index, ${nofollow ? "nofollow" : "follow"}, max-image-preview:large`
      }
    />
    <link rel="canonical" href={canonicalUrl} />
    {googleVerification ? (
      <meta name="google-site-verification" content={googleVerification} />
    ) : null}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage ? <meta property="og:image" content={socialImage} /> : null}
    {socialImage && socialImageAlt ? (
      <meta property="og:image:alt" content={socialImageAlt} />
    ) : null}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage ? <meta name="twitter:image" content={socialImage} /> : null}
    {socialImage && socialImageAlt ? (
      <meta name="twitter:image:alt" content={socialImageAlt} />
    ) : null}
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.pexels.com" />
    {preloadImage ? <link rel="preload" as="image" href={preloadImage} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <StructuredData schema={siteSchema} />
    {structuredData.map((node) => (
      <StructuredData schema={{ "@context": "https://schema.org", ...node }} />
    ))}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <Header items={NAV_ITEMS} currentPath={currentPath} brandName={brandName} />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer
      items={NAV_ITEMS}
      brandName={brandName}
      serviceAreaStatement={serviceAreaStatement}
      reviewUrl={reviewUrl}
      footerCta={siteSettings.footerCta}
      socials={socials}
    />
    <FloatingMessenger messengerUrl={siteSettings.messengerUrl} />
  </body>
</html>
