---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingMessenger from "../components/FloatingMessenger.astro";
import StructuredData from "../components/StructuredData.astro";
import { getContent } from "../lib/content/repository";
import { loadPublicPages } from "../lib/supabase/public";
import type { SeoPageKey } from "../lib/cms/types";
import { NAV_ITEMS } from "../lib/navigation";
import "@fontsource/fraunces/latin-400.css";
import "@fontsource/fraunces/latin-400-italic.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/live.css";
import "../styles/mobile-nav.css";
import "../styles/gallery-lightbox.css";
// Dialog + form systems used by islands (review modal): loaded globally like
// the lightbox/nav styles so island CSS never depends on page-level imports.
import "../styles/inquiry-form.css";
import "../styles/review-modal.css";

interface Props {
  title: string;
  description: string;
  /** Extra class on <body>, e.g. "page-home" for a full-bleed dark canvas. */
  bodyClass?: string;
  /** URL to preload (LCP image), homepage hero background. */
  preloadImage?: string;
  /** Social share image; defaults to the hero background image. */
  ogImage?: string;
  /** Alt text for the social share image; defaults to the brand or hero alt. */
  ogImageAlt?: string;
  /** Absolute-URL canonical override; defaults to the page URL. */
  canonicalUrl?: string;
  /** Keep a page out of search results (for example the 404 page). */
  noindex?: boolean;
  /** Keep crawlers from following this page's links. */
  nofollow?: boolean;
  /** OG overrides; default to the page title and description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Extra Schema.org nodes for this page, rendered alongside the site graph. */
  structuredData?: Record<string, unknown>[];
  /** SEO page key for live metadata patching (SeoLive island). */
  seoPageKey?: SeoPageKey;
}
const {
  title,
  description,
  bodyClass = "",
  preloadImage,
  ogImage,
  ogImageAlt,
  canonicalUrl: canonicalOverride,
  noindex = false,
  nofollow = false,
  ogTitle,
  ogDescription,
  structuredData = [],
  seoPageKey,
} = Astro.props;
const { site } = getContent();
// Site chrome (brand, footer, messenger) reads the CMS settings blob so the
// Site Settings admin is real; hero imagery keeps its mock source for now.
const { settings: siteSettings } = await loadPublicPages();
const brandName = siteSettings.brandName || site.brandName;
// CMS social profiles (Site Settings). Empty until the client saves real
// profile URLs, so both the footer/contact blocks and sameAs stay hidden.
const socials = siteSettings.socials ?? [];
// CMS favicon (Site Settings): overrides the bundled SVG when uploaded.
const faviconSrc = siteSettings.favicon?.src;
const faviconType = faviconSrc ? faviconMime(faviconSrc) : "image/svg+xml";
const faviconHref = faviconSrc || "/favicon.svg";
const currentPath = Astro.url.pathname;

/** MIME type for an uploaded favicon, derived from its file extension. */
function faviconMime(src: string): string {
  const path = src.split(/[?#]/)[0].toLowerCase();
  if (path.endsWith(".webp")) return "image/webp";
  if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg";
  return "image/png";
}

const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
// Canonical URLs are normalised without a trailing slash (root keeps "/"),
// unless the SEO module sets an absolute-URL override for the page.
const canonicalPath = currentPath.replace(/\/+$/, "") || "/";
const canonicalUrl = canonicalOverride ?? new URL(canonicalPath, siteOrigin).href;

const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;

// Social image comes only from the per-page SEO setting (all public pages
// provide a client-uploaded image). There is deliberately no global stock
// fallback, so a placeholder can never be shared as the brand's OG image.
const socialImageSrc = ogImage;
const socialImage = socialImageSrc ? new URL(socialImageSrc, canonicalUrl).href : undefined;
const socialImageAlt = socialImageSrc ? ogImageAlt || brandName : undefined;

// CMS images are served from Supabase Storage; opening the connection early
// shortens the LCP image fetch. The Pexels mock origin is only used when a
// mock (dev/seed) image is actually referenced.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
const supabaseOrigin = supabaseUrl ? new URL(supabaseUrl).origin : undefined;
const usesMockImage = [preloadImage, socialImageSrc].some((src) =>
  src?.includes("images.pexels.com"),
);

// Google Search Console URL-prefix verification. The token is public and must
// appear in the served HTML; the env value can override it per environment.
const googleVerification =
  (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined) ??
  "HemkyvmWRx4jOA7etp5IrpO5f0UIdf3jQhkP_38mvkQ";

// Google Analytics 4 (Phase 0, DEC-052). Rendered only when a valid
// Measurement ID is configured; the ID is public by design and no secret is
// stored here. Blank (the current default) emits nothing, so no duplicate or
// placeholder installation can occur.
const rawGa4Id = (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined)?.trim();
const ga4Id = rawGa4Id && /^G-[A-Z0-9]+$/i.test(rawGa4Id) ? rawGa4Id : undefined;

/**
 * Site-wide structured data.
 *
 * Only confirmed facts are emitted: brand, production URL, contact details,
 * Melbourne/Victoria service area and CMS-saved social profile URLs (sameAs).
 * The business is a mobile service-area business, so no postal address is
 * emitted (there is no public street address — DEC-016/Phase 0). No Review or
 * AggregateRating data is emitted: the on-site testimonials are placeholder
 * content awaiting real client reviews, and Google does not support
 * self-serving review snippets.
 */
const logoUrl = siteSettings.logo?.src ? new URL(siteSettings.logo.src, siteOrigin).href : undefined;
const contactPhone = siteSettings.phonePrimary?.replace(/\s+/g, "") || undefined;
const contactEmail = siteSettings.contactEmail?.trim() || undefined;
const sameAs = socials.length > 0 ? socials.map((social) => social.url) : undefined;
const areaServed = [
  { "@type": "City", name: "Melbourne" },
  { "@type": "AdministrativeArea", name: "Victoria" },
];
const businessDescription =
  "Photobooth hire for weddings, corporate events, birthdays and private celebrations across Melbourne and Victoria.";

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: brandName,
      url: `${siteOrigin}/`,
      description: businessDescription,
      ...(logoUrl ? { logo: logoUrl } : {}),
      areaServed,
      ...(sameAs ? { sameAs } : {}),
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteOrigin}/#localbusiness`,
      name: brandName,
      url: `${siteOrigin}/`,
      description: businessDescription,
      ...(logoUrl ? { image: logoUrl, logo: logoUrl } : {}),
      ...(contactPhone ? { telephone: contactPhone } : {}),
      ...(contactEmail ? { email: contactEmail } : {}),
      areaServed,
      parentOrganization: { "@id": `${siteOrigin}/#organization` },
      ...(sameAs ? { sameAs } : {}),
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      url: `${siteOrigin}/`,
      name: brandName,
      inLanguage: "en-AU",
      publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "en-AU",
      isPartOf: { "@id": `${siteOrigin}/#website` },
      about: { "@id": `${siteOrigin}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en-AU" data-seo-page={seoPageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf6ef" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? `noindex, ${nofollow ? "nofollow" : "follow"}`
          : `index, ${nofollow ? "nofollow" : "follow"}, max-image-preview:large`
      }
    />
    <link rel="canonical" href={canonicalUrl} />
    {googleVerification ? (
      <meta name="google-site-verification" content={googleVerification} />
    ) : null}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage ? <meta property="og:image" content={socialImage} /> : null}
    {socialImage && socialImageAlt ? (
      <meta property="og:image:alt" content={socialImageAlt} />
    ) : null}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage ? <meta name="twitter:image" content={socialImage} /> : null}
    {socialImage && socialImageAlt ? (
      <meta name="twitter:image:alt" content={socialImageAlt} />
    ) : null}
    {supabaseOrigin ? <link rel="preconnect" href={supabaseOrigin} /> : null}
    {usesMockImage ? <link rel="preconnect" href="https://images.pexels.com" crossorigin /> : null}
    {preloadImage ? (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    ) : null}
    <link rel="icon" type={faviconType} href={faviconHref} />
    {ga4Id ? (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`}
        />
      </>
    ) : null}
    <StructuredData schema={siteSchema} />
    {structuredData.map((node) => (
      <StructuredData schema={{ "@context": "https://schema.org", ...node }} />
    ))}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <Header items={NAV_ITEMS} currentPath={currentPath} initialSettings={siteSettings} />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer items={NAV_ITEMS} initialSettings={siteSettings} />
    <FloatingMessenger initialSettings={siteSettings} />
    <script>
      import { initLiveChrome } from "../lib/live/liveChrome";
      import { initAnalytics } from "../lib/analytics";

      // Live chrome (static sections + SEO) without React.
      initLiveChrome();

      // GA4 conversion events (no-op when the measurement ID is blank).
      initAnalytics();

      // Load the React dialogs on demand (first trigger click) so react-dom
      // stays off the initial load. Falls back to normal navigation if the
      // chunk fails to load.
      let reviewMounted = false;
      let lightboxMounted = false;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const reviewTrigger = target.closest("[data-review-open]");
        if (reviewTrigger && !reviewMounted) {
          event.preventDefault();
          reviewMounted = true;
          void (async () => {
            try {
              const { mountReview } = await import("../components/islands/reviewMount");
              const el = document.getElementById("review-config");
              let config: { eventTypes?: string[]; turnstileSiteKey?: string } = {};
              try {
                config = el?.textContent ? JSON.parse(el.textContent) : {};
              } catch {
                config = {};
              }
              mountReview(config, reviewTrigger as HTMLElement);
            } catch {
              // Leave the trigger inert rather than throwing.
            }
          })();
          return;
        }

        const lightboxAnchor = target.closest<HTMLAnchorElement>("[data-lightbox]");
        if (lightboxAnchor && !lightboxMounted) {
          event.preventDefault();
          lightboxMounted = true;
          void (async () => {
            try {
              const { mountLightbox } = await import("../components/islands/lightboxMount");
              mountLightbox(lightboxAnchor);
            } catch {
              window.location.href = lightboxAnchor.href;
            }
          })();
        }
      });
    </script>
  </body>
</html>
