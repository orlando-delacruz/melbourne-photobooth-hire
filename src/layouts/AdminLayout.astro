---
// Admin layout: quiet chrome for the content admin. Separate from the public
// BaseLayout on purpose: no public navigation, footer, canonical URLs or
// public JSON-LD. Admin routes are also disallowed in public/robots.txt and
// excluded from the sitemap, and carry a noindex meta tag as defence in depth.
import "../styles/tokens.css";
import "../styles/admin.css";
import "sweetalert2/dist/sweetalert2.min.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17120c" />
    <title>{title} | Content Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="ad-body">
    <slot />
  </body>
</html>
