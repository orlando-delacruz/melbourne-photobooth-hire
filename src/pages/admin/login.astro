---
import AdminLayout from "../../layouts/AdminLayout.astro";
import LoginForm from "../../components/admin/LoginForm";
---

<AdminLayout title="Sign in">
  <main class="ad-login">
    <div class="ad-login-card">
      <div class="ad-login-brand">
        <span class="ad-brand-mark" aria-hidden="true">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
            <circle cx="12" cy="13" r="3"></circle>
          </svg>
        </span>
        <span class="ad-login-brand-text">Melbourne Photobooth Hire</span>
      </div>
      <h1 class="ad-login-title">Sign in</h1>
      <p class="ad-login-lede">Access the content admin for your website.</p>
      <LoginForm client:load />
    </div>
  </main>
</AdminLayout>
