---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminShell from "../../components/admin/AdminShell.astro";
import FaqEditor from "../../components/admin/editors/FaqEditor";
import { sectionByKey } from "../../components/admin/sections";

const section = sectionByKey("faq");
---

<AdminLayout title={`Edit ${section.label}`}>
  <AdminShell
    active={section.key}
    title={`Edit ${section.label}`}
    lede={section.blurb}
    publicHref={section.publicHref}
  >
    <FaqEditor client:load />
  </AdminShell>
</AdminLayout>
