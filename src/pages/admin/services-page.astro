---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminShell from "../../components/admin/AdminShell.astro";
import ServicesPageEditor from "../../components/admin/editors/ServicesPageEditor";
import { CMS_SECTIONS } from "../../components/admin/sections";

const section = CMS_SECTIONS.find((item) => item.key === "services")!;
---

<AdminLayout title={`Edit ${section.label}`}>
  <AdminShell
    active={section.key}
    title={section.label}
    heading={`Edit ${section.label}`}
    lede={section.blurb}
    publicHref={section.publicHref}
  >
    <ServicesPageEditor client:load />
  </AdminShell>
</AdminLayout>
