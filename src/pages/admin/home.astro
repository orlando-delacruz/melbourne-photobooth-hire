---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminShell from "../../components/admin/AdminShell.astro";
import HomeEditor from "../../components/admin/editors/HomeEditor";
import { CMS_SECTIONS } from "../../components/admin/sections";

const section = CMS_SECTIONS.find((item) => item.key === "home")!;
---

<AdminLayout title={`Edit ${section.label}`}>
  <AdminShell
    active={section.key}
    title={`Edit ${section.label}`}
    lede={section.blurb}
    publicHref={section.publicHref}
  >
    <HomeEditor client:load />
  </AdminShell>
</AdminLayout>
