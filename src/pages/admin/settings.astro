---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminShell from "../../components/admin/AdminShell.astro";
import SettingsEditor from "../../components/admin/editors/SettingsEditor";
import { SETTINGS_SECTION } from "../../components/admin/sections";

const section = SETTINGS_SECTION;
---

<AdminLayout title="Site settings">
  <AdminShell
    active={section.key}
    title="Settings"
    heading={section.label}
    lede={section.blurb}
    publicHref={section.publicHref}
  >
    <SettingsEditor client:load />
  </AdminShell>
</AdminLayout>
