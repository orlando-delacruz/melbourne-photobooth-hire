---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminShell from "../../components/admin/AdminShell.astro";
import AboutEditor from "../../components/admin/editors/AboutEditor";
import { CMS_SECTIONS } from "../../components/admin/sections";

const section = CMS_SECTIONS.find((item) => item.key === "about")!;
---

<AdminLayout title={`Edit ${section.label}`}>
  <AdminShell
    active={section.key}
    title={section.label}
    heading={`Edit ${section.label}`}
    lede={section.blurb}
    publicHref={section.publicHref}
  >
    <AboutEditor client:load />
  </AdminShell>
</AdminLayout>
