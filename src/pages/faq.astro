---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveFaqSection from "../components/islands/LiveFaqSection";
import LiveFaqSupport from "../components/islands/LiveFaqSupport";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// FAQ rows seed the live island (DEC-033): edits, creates, deletes and
// highlight changes patch the list with no refresh.
const [{ ctaImage, serviceImages }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("faq"),
]);
const faqPage = cmsPages.faq;
// The FAQ header uses a client-uploaded service photo; the previous Pexels
// placeholder is no longer used as production imagery (Phase 0, DEC-052).
const headerImage = serviceImages?.["360-video-booth"] ?? serviceImages?.["premium-photobooth"];
const headerImageSrc = headerImage?.src;
setPublicCache(Astro.response.headers);
---

<BaseLayout
  seoPageKey="faq"
  title={seo.seoTitle || "Photobooth Hire FAQs Melbourne | Pricing, Setup & Policies"}
  description={
    seo.seoDescription ||
    "Answers to common Melbourne photobooth hire questions: pricing, what's included, travel, setup time, space requirements and booking policies."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
>
  <LivePageHeader
    client:visible
    pageKey="faq"
    initial={faqPage.header}
    imageSrc={headerImageSrc}
    imageAlt={headerImage?.alt}
  />

  {liveModules.faqs.length === 0 ? (
    <p class="section">Questions and answers will appear here once client-confirmed.</p>
  ) : (
    <section class="section faq" aria-label="Frequently asked questions">
      <div class="faq-layout">
        <LiveFaqSection client:visible initial={liveModules.faqs} emptyCopy={faqPage.emptyCopy} />

        <aside class="faq-aside">
          <LiveFaqSupport client:visible initialPage={faqPage} />
        </aside>
      </div>
    </section>
  )}

  <LiveCtaBand
    client:visible
    pageKey="faq"
    initial={faqPage.ctaBand}
    id="faq-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>

<style>
  /* NOTE: the numbered card accordion (.faq-list) and the empty-line styles
     live in styles/live.css — the LiveFaqSection island renders those nodes. */

  /* ── Layout ─────────────────────────────────────────────────────────── */

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .faq-main {
    min-width: 0;
  }

  .faq-aside {
    max-width: 26rem;
  }

  @media (min-width: 900px) {
    .faq-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: var(--space-2xl);
    }
    .faq-aside {
      position: sticky;
      top: 7rem;
    }
  }
</style>
