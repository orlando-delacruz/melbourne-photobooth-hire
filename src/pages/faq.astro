---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { getContent } from "../lib/content/repository";

const { faqs } = getContent();
---

<BaseLayout
  title="FAQ | Melbourne Photobooth Hire"
  description="Booking, pricing, inclusions, travel, setup and policy answers from Melbourne Photobooth Hire."
>
  <h1>FAQ</h1>
  <p>Can&apos;t find what you&apos;re looking for? Send an enquiry via the contact page.</p>
  {faqs.length === 0 ? (
    <p>Questions and answers will appear here once client-confirmed.</p>
  ) : (
    <ul>
      {faqs.map((faq) => (
        <li>
          <h2>{faq.question}</h2>
          <p>{faq.answer}</p>
        </li>
      ))}
    </ul>
  )}
  <p>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>
