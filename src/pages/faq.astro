---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import Accordion from "../components/Accordion.astro";
import CtaBand from "../components/CtaBand.astro";
import Reveal from "../components/islands/Reveal";
import CmsEcho from "../components/islands/CmsEcho";
import { getContent } from "../lib/content/repository";

const { faqs, ctaImage } = getContent();

const searchIcon =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>';

const chatIcon =
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
---

<BaseLayout
  title="Photobooth Hire FAQs Melbourne | Pricing, Setup & Policies"
  description="Answers to common Melbourne photobooth hire questions: pricing, what's included, travel, setup time, space requirements and booking policies."
>
  <PageHeader
    title="Frequently asked questions"
    eyebrow="Good to know"
    lede="Everything hosts usually ask before booking. If your question isn't here, we're one message away."
    imageSrc={ctaImage?.src}
    imageAlt={ctaImage?.alt}
  />

  {faqs.length === 0 ? (
    <p class="section">Questions and answers will appear here once client-confirmed.</p>
  ) : (
    <section class="section faq" aria-label="Frequently asked questions">
      <div class="faq-toolbar">
        <div class="faq-search-panel">
          <label class="sr-only" for="faq-search">
            Search frequently asked questions
          </label>
          <span class="faq-search-icon" aria-hidden="true" set:html={searchIcon} />
          <input
            id="faq-search"
            class="faq-search-input"
            type="search"
            placeholder="Search questions"
            autocomplete="off"
          />
        </div>
        <p class="faq-count" data-faq-count aria-live="polite">
          {faqs.length} questions
        </p>
      </div>

      <div class="faq-layout">
        <div class="faq-main">
          <Reveal client:visible>
            <Accordion items={faqs} />
          </Reveal>
          <p class="faq-empty" data-faq-empty hidden>
            No questions match your search. Try a different word, or ask us directly.
          </p>
        </div>

        <aside class="faq-aside">
          <div class="faq-support">
            <span class="faq-support-icon" aria-hidden="true" set:html={chatIcon} />
            <h2>Still have a question?</h2>
            <p>
              Send it through with your event details and we'll reply, usually within one business
              day.
            </p>
            <Button href="/contact" variant="primary" tone="dark" size="lg" arrow>
              Ask a question
            </Button>
          </div>
        </aside>
      </div>
    </section>
  )}

  <CtaBand
    id="faq-enquire"
    eyebrow="Ready when you are"
    headline="Questions answered? Let's talk dates."
    lede="Send your event details and we'll confirm availability and the right booth for the night."
    primaryHref="/contact"
    primaryLabel="Enquire now"
    secondaryHref="/packages"
    secondaryLabel="View packages"
    imageSrc={ctaImage?.src}
    imageAlt={ctaImage?.alt}
  />
  <CmsEcho page="faq" client:idle />
</BaseLayout>

<script>
  // Progressive enhancement: filter the FAQ list as the visitor types. Without
  // JavaScript the search is hidden and every question stays available.
  const input = document.getElementById("faq-search") as HTMLInputElement | null;
  const countEl = document.querySelector("[data-faq-count]");
  const emptyEl = document.querySelector<HTMLElement>("[data-faq-empty]");
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>(".accordion__item"));

  if (input && items.length > 0) {
    const total = items.length;
    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const text = (item.textContent || "").toLowerCase();
        const match = query === "" || text.includes(query);
        item.style.display = match ? "" : "none";
        if (match) visible += 1;
      });
      if (countEl) {
        countEl.textContent =
          query === "" ? total + " questions" : visible + " of " + total + " questions";
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
    };
    input.addEventListener("input", apply);
    apply();
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Toolbar ────────────────────────────────────────────────────────── */

  .faq-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }
  .faq-search-panel {
    position: relative;
    flex: 1 1 20rem;
    max-width: 26rem;
  }
  .faq-search-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 1rem 0.7rem 2.7rem;
    border: 1px solid var(--color-input-border);
    border-radius: var(--radius-md);
    font: inherit;
    font-size: var(--text-body);
    color: var(--color-ink);
    background: var(--color-surface);
    transition:
      border-color var(--motion-quick) var(--ease-default),
      box-shadow var(--motion-quick) var(--ease-default);
  }
  .faq-search-input::placeholder {
    color: var(--color-ink-faint);
  }
  .faq-search-input:hover {
    border-color: var(--color-ink-soft);
  }
  .faq-search-input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }
  .faq-search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    color: var(--color-ink-faint);
    pointer-events: none;
  }
  .faq-count {
    margin: 0;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
  }

  /* Hide the search when JavaScript is unavailable. */
  html:not(.js) .faq-search-panel {
    display: none;
  }

  /* ── Layout ─────────────────────────────────────────────────────────── */

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .faq-main {
    min-width: 0;
  }
  .faq-empty {
    margin: var(--space-lg) 0 0;
    color: var(--color-ink-soft);
  }

  .faq-aside {
    max-width: 26rem;
  }
  .faq-support {
    position: relative;
    overflow: hidden;
    padding: var(--space-lg);
    border: 1px solid var(--color-ink-hairline-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-surface-dark), var(--color-ink));
    box-shadow: var(--elevation-2);
    color: var(--color-on-ink);
  }
  /* Champagne hairline plus an interior spotlight. */
  .faq-support::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-on-dark) 22%,
      #fff2c8 50%,
      var(--color-accent-on-dark) 78%,
      transparent
    );
    pointer-events: none;
  }
  .faq-support::after {
    content: "";
    position: absolute;
    inset: -35% -20% auto;
    height: 65%;
    background: radial-gradient(60% 100% at 50% 0%, rgba(230, 206, 138, 0.16), transparent 70%);
    pointer-events: none;
  }
  .faq-support-icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-ink-hairline-strong);
    background: var(--color-accent-wash);
    color: var(--color-accent-on-dark);
  }
  .faq-support h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 var(--space-2xs);
    color: var(--color-on-ink);
    font-size: var(--text-h3);
  }
  .faq-support p {
    position: relative;
    z-index: 1;
    margin: 0 0 var(--space-lg);
    color: var(--color-on-ink-secondary);
  }
  .faq-support :global(.button) {
    position: relative;
    z-index: 1;
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .faq-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: var(--space-2xl);
    }
    .faq-aside {
      position: sticky;
      top: 7rem;
    }
  }
</style>
