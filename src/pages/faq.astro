---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import { getContent } from "../lib/content/repository";

const { faqs } = getContent();
---

<BaseLayout
  title="FAQ | Melbourne Photobooth Hire"
  description="Booking, pricing, inclusions, travel, setup and policy answers from Melbourne Photobooth Hire."
>
  <PageHeader
    title="FAQ"
    eyebrow="Answers"
    lede="Can't find what you're looking for? Send an enquiry via the contact page."
  />
  {faqs.length === 0 ? (
    <p class="section">Questions and answers will appear here once client-confirmed.</p>
  ) : (
    <ul class="faq-list section">
      {faqs.map((faq) => (
        <li>
          <h2>{faq.question}</h2>
          <p>{faq.answer}</p>
        </li>
      ))}
    </ul>
  )}
  <p>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>

<style>
  .faq-list {
    list-style: none;
    margin: 0 0 var(--space-sm);
    padding: 0;
    display: grid;
    gap: var(--space-md);
    max-width: var(--text-max-width);
  }
  .faq-list li {
    border-bottom: 1px solid var(--color-divider);
    padding-bottom: var(--space-md);
  }
  .faq-list h2 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-h3);
  }
  .faq-list p {
    margin: 0;
    color: var(--color-ink-soft);
  }
</style>
