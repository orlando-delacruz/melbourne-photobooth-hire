---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveGallerySection from "../components/islands/LiveGallerySection";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// The grid patches itself when the Gallery module changes (DEC-033).
const [{ ctaImage, serviceImages }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("gallery"),
]);
const galleryPage = cmsPages.gallery;
setPublicCache(Astro.response.headers);
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImage = serviceImages?.["360-video-booth"];
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Gallery", path: "/gallery" },
]);
---

<BaseLayout
  seoPageKey="gallery"
  title={seo.seoTitle || "Photobooth Gallery Melbourne | Weddings, Parties & Events"}
  description={
    seo.seoDescription ||
    "See the booths, backdrops and moments Melbourne Photobooth Hire stages at weddings, birthdays, corporate events and school formals."
  }
  ogImage={seo.ogImage.src || headerImage?.src || undefined}
  ogImageAlt={seo.ogImage.alt || headerImage?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? seo.ogImage.width : headerImage?.width}
  ogImageHeight={seo.ogImage.src ? seo.ogImage.height : headerImage?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImage?.src}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={[breadcrumbSchema]}
>
  <LivePageHeader
    client:visible
    pageKey="gallery"
    initial={galleryPage.header}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/gallery", label: "Gallery" }]}
    imageSrc={headerImage?.src}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  />

  <LiveGallerySection
    client:visible
    initial={liveModules.gallery}
    emptyState={galleryPage.emptyState}
  />

  <p class="gallery-services-link">
    <span class="gallery-services-link-lead">Looking for a specific booth?</span>
    <a href="/services">
      <span>Explore our photobooth services</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </svg>
    </a>
  </p>

  <LiveCtaBand
    client:visible
    pageKey="gallery"
    initial={galleryPage.ctaBand}
    id="gallery-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>

<style>
  /* Quiet cross-link trail below the gallery grid. Mirrors the booth-page
     cross-links: a champagne hairline, a soft lead line and one arrow link
     in the accent colour — secondary navigation, not a competing CTA. */
  .gallery-services-link {
    position: relative;
    max-width: 44rem;
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-lg);
    text-align: center;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
  .gallery-services-link::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-line),
      transparent
    );
    pointer-events: none;
  }
  .gallery-services-link-lead {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead);
    color: var(--color-ink);
  }
  .gallery-services-link a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding-block: 0.35rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .gallery-services-link a svg {
    transition: transform var(--motion-quick) var(--ease-default);
  }
  .gallery-services-link a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .gallery-services-link a:hover svg {
    transform: translateX(3px);
  }
  .gallery-services-link a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-services-link a,
    .gallery-services-link a svg {
      transition: none;
    }
    .gallery-services-link a:hover svg {
      transform: none;
    }
  }
</style>
