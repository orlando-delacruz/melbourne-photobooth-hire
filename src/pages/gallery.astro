---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { getContent } from "../lib/content/repository";

const { gallery } = getContent();
---

<BaseLayout
  title="Gallery | Melbourne Photobooth Hire"
  description="Real event imagery from Melbourne Photobooth Hire. Imagery pending client approval."
>
  <h1>Gallery</h1>
  {gallery.length === 0 ? (
    <p>No images are available yet.</p>
  ) : (
    <ul>
      {gallery.map((item) => (
        <li>
          <img src={item.src} alt={item.alt} loading="lazy" />
        </li>
      ))}
    </ul>
  )}
  <p>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>
