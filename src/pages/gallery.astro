---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveGallerySection from "../components/islands/LiveGallerySection";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// The grid patches itself when the Gallery module changes (DEC-033).
const [{ ctaImage, serviceImages }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("gallery"),
]);
const galleryPage = cmsPages.gallery;
setPublicCache(Astro.response.headers);
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImage = serviceImages?.["360-video-booth"];
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Gallery", path: "/gallery" },
]);
---

<BaseLayout
  seoPageKey="gallery"
  title={seo.seoTitle || "Photobooth Gallery Melbourne | Weddings, Parties & Events"}
  description={
    seo.seoDescription ||
    "See the booths, backdrops and moments Melbourne Photobooth Hire stages at weddings, birthdays, corporate events and school formals."
  }
  ogImage={seo.ogImage.src || headerImage?.src || undefined}
  ogImageAlt={seo.ogImage.alt || headerImage?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? undefined : headerImage?.width}
  ogImageHeight={seo.ogImage.src ? undefined : headerImage?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImage?.src}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={[breadcrumbSchema]}
>
  <LivePageHeader
    client:visible
    pageKey="gallery"
    initial={galleryPage.header}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/gallery", label: "Gallery" }]}
    imageSrc={headerImage?.src}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  />

  <LiveGallerySection
    client:visible
    initial={liveModules.gallery}
    emptyState={galleryPage.emptyState}
  />

  <p class="gallery-services-link">
    Looking for a specific booth? <a href="/services">Explore our photobooth services</a>.
  </p>

  <LiveCtaBand
    client:visible
    pageKey="gallery"
    initial={galleryPage.ctaBand}
    id="gallery-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>

<style>
  .gallery-services-link {
    margin: var(--space-lg) 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
</style>
