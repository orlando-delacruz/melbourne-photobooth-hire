---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import GalleryLightbox from "../components/islands/GalleryLightbox";
import LiveGallerySection from "../components/islands/LiveGallerySection";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// The grid patches itself when the Gallery module changes (DEC-033).
const [{ ctaImage, serviceImages }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("gallery"),
]);
const galleryPage = cmsPages.gallery;
setPublicCache(Astro.response.headers);
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImage = serviceImages?.["360-video-booth"]?.src;
---

<BaseLayout
  seoPageKey="gallery"
  title={seo.seoTitle || "Photobooth Gallery Melbourne | Weddings, Parties & Events"}
  description={
    seo.seoDescription ||
    "See the booths, backdrops and moments Melbourne Photobooth Hire stages at weddings, birthdays, corporate events and school formals."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImage}
>
  <LivePageHeader
    client:visible
    pageKey="gallery"
    initial={galleryPage.header}
    imageSrc={headerImage}
    imageAlt={serviceImages?.["360-video-booth"]?.alt}
  />

  <LiveGallerySection
    client:visible
    initial={liveModules.gallery}
    emptyState={galleryPage.emptyState}
  />

  <LiveCtaBand
    client:visible
    pageKey="gallery"
    initial={galleryPage.ctaBand}
    id="gallery-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />

  <GalleryLightbox client:idle />
</BaseLayout>
