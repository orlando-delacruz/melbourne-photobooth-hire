---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import LiveLegalPage from "../components/islands/LiveLegalPage";
import { loadPublicPages, loadPublicSeo } from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

const seo = await loadPublicSeo("terms");
const { legal } = await loadPublicPages();
const page = legal.terms;
setPublicCache(Astro.response.headers);
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Terms & Conditions", path: "/terms" },
]);
---

<BaseLayout
  seoPageKey="terms"
  title={seo.seoTitle || "Terms & Conditions | Melbourne Photobooth Hire"}
  description={
    seo.seoDescription ||
    "The terms and conditions that apply to photobooth hire with Melbourne Photobooth Hire, including bookings, deposits, rescheduling and venue requirements."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  structuredData={[breadcrumbSchema]}
>
  <LiveLegalPage
    client:visible
    pageKey="terms"
    initial={page}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/terms", label: "Terms & Conditions" }]}
  />
</BaseLayout>
