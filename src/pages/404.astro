---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { NAV_ITEMS } from "../lib/navigation";
---

<BaseLayout
  title="Page Not Found | Melbourne Photobooth Hire"
  description="The requested page could not be found on Melbourne Photobooth Hire."
  noindex
>
  <section class="not-found bleed on-dark" aria-labelledby="not-found-title">
    <div class="not-found-glow" aria-hidden="true"></div>
    <div class="container not-found-inner">
      <p class="not-found-code" aria-hidden="true">
        404
      </p>
      <h1 id="not-found-title">This page didn't make the cut.</h1>
      <p class="lede">
        The link may be broken, or the page may have moved. Let's get you back to the good part.
      </p>
      <p class="not-found-ctas">
        <Button href="/" variant="primary" tone="dark" size="lg" arrow>
          Back to homepage
        </Button>
        <Button href="/contact" variant="secondary" tone="dark" size="lg">
          Enquire now
        </Button>
      </p>
      <nav class="not-found-nav" aria-label="Popular pages">
        <span>Popular:</span>
        <ul>
          {NAV_ITEMS.filter((item) => item.href !== "/").map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-deep);
    padding-block: clamp(5rem, 14vw, 10rem);
  }
  .not-found-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 120% at 80% 10%, rgba(230, 206, 138, 0.16), transparent 60%),
      radial-gradient(80% 100% at 10% 100%, rgba(230, 206, 138, 0.08), transparent 60%);
    pointer-events: none;
  }
  .not-found-inner {
    position: relative;
    max-width: 44rem;
  }
  .not-found-code {
    margin: 0;
    color: var(--color-accent-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: 0.9;
    opacity: 0.5;
  }
  .not-found h1 {
    margin: var(--space-md) 0 var(--space-sm);
    color: var(--color-on-ink);
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }
  .lede {
    margin: 0 0 var(--space-lg);
    max-width: 34rem;
    color: var(--color-on-ink-secondary);
    font-size: var(--text-lead);
  }
  .not-found-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-xl);
  }
  .not-found-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ink-hairline);
    color: var(--color-on-ink-faint);
    font-size: var(--text-small);
  }
  .not-found-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .not-found-nav a {
    color: var(--color-on-ink-secondary);
  }
  .not-found-nav a:hover {
    color: var(--color-accent-on-dark);
  }
</style>
