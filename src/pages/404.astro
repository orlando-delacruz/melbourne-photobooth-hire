---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Page not found | Melbourne Photobooth Hire"
  description="The requested page could not be found on Melbourne Photobooth Hire."
>
  <section class="not-found section" aria-labelledby="not-found-title">
    <h1 id="not-found-title">Page not found</h1>
    <p class="lede">The page you are looking for does not exist.</p>
    <Button href="/" variant="primary">
      Back to homepage
    </Button>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    max-width: var(--text-max-width);
  }
  .lede {
    margin: 0 0 var(--space-sm);
    color: var(--color-ink-soft);
  }
</style>
