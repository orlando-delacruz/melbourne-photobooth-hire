---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import LiveLegalPage from "../components/islands/LiveLegalPage";
import { loadPublicContent, loadPublicPages, loadPublicSeo } from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

const [seo, { legal }, { heroBackgroundImage }] = await Promise.all([
  loadPublicSeo("privacy"),
  loadPublicPages(),
  loadPublicContent(),
]);
const page = legal.privacy;
// Legal pages have no photographic header; the home hero is the brand-level
// OG fallback (OG = hero rule) so shares still render a real brand image.
const ogFallback = heroBackgroundImage;
setPublicCache(Astro.response.headers);
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path: "/privacy" },
]);
---

<BaseLayout
  seoPageKey="privacy"
  title={seo.seoTitle || "Privacy Policy | Melbourne Photobooth Hire"}
  description={
    seo.seoDescription ||
    "How Melbourne Photobooth Hire collects, uses, stores and protects the personal information you share through this website."
  }
  ogImage={seo.ogImage.src || ogFallback?.src || undefined}
  ogImageAlt={seo.ogImage.alt || ogFallback?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? undefined : ogFallback?.width}
  ogImageHeight={seo.ogImage.src ? undefined : ogFallback?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  structuredData={[breadcrumbSchema]}
>
  <LiveLegalPage
    client:visible
    pageKey="privacy"
    initial={page}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/privacy", label: "Privacy Policy" }]}
  />
</BaseLayout>
