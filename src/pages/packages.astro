---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getContent } from "../lib/content/repository";

const { packages, addOns, bookingPolicies } = getContent();
---

<BaseLayout
  title="Packages | Melbourne Photobooth Hire"
  description="Starter, Standard and Premium photobooth packages with pricing, inclusions, add-ons and booking policies."
>
  <h1>Packages</h1>
  <p>
    Every booking comes dressed to impress — red carpet and golden bollard entrance setup included
    as standard, along with full setup and pack-down handled by our team.
  </p>
  {packages.length === 0 ? (
    <p>
      Package options will be shown here once confirmed. Until then, please enquire for current
      options.
    </p>
  ) : (
    <ul>
      {packages.map((pkg) => (
        <li>
          <article>
            <h2>
              {pkg.name}
              {pkg.badge ? ` — ${pkg.badge}` : ""}
            </h2>
            <p>{pkg.summary}</p>
            <p>
              {pkg.durationLabel} · {pkg.priceLabel}
            </p>
            <ul>
              {pkg.inclusions.map((inclusion) => (
                <li>{inclusion}</li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ul>
  )}
  <SectionHeading title="Add-ons" id="packages-addons" />
  <ul>
    {addOns.map((addOn) => (
      <li>
        <h2>{addOn.name}</h2>
        <p>{addOn.detail}</p>
      </li>
    ))}
  </ul>
  <SectionHeading title="Booking policies" id="packages-policies" />
  <ul>
    {bookingPolicies.map((policy) => (
      <li>{policy}</li>
    ))}
  </ul>
  <SectionHeading title="Next step" id="packages-next" />
  <p>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>
