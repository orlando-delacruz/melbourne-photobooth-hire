---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveAboutSections from "../components/islands/LiveAboutSections";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// Raw CMS modules seed the story-image derivation in the live island.
const [{ serviceImages, ctaImage }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("about"),
]);
const aboutPage = cmsPages.about;
const headerImage = serviceImages?.["roaming-photobooth"];
const headerImageSrc = headerImage?.src;
setPublicCache(Astro.response.headers);
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
]);
---

<BaseLayout
  seoPageKey="about"
  title={seo.seoTitle || "About Us | Melbourne Photobooth Hire"}
  description={
    seo.seoDescription ||
    "Meet Melbourne Photobooth Hire, a local Melbourne team styling and running photobooth experiences for weddings, birthdays and corporate events."
  }
  ogImage={seo.ogImage.src || headerImageSrc || undefined}
  ogImageAlt={seo.ogImage.alt || headerImage?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? seo.ogImage.width : headerImage?.width}
  ogImageHeight={seo.ogImage.src ? seo.ogImage.height : headerImage?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={[breadcrumbSchema]}
>
  <LivePageHeader
    client:visible
    pageKey="about"
    initial={aboutPage.header}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/about", label: "About" }]}
    imageSrc={headerImageSrc}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  />

  <LiveAboutSections
    client:visible
    initialPage={aboutPage}
    initialGallery={liveModules.gallery}
    initialServices={liveModules.services}
  />

  <LiveCtaBand
    client:visible
    pageKey="about"
    initial={aboutPage.ctaBand}
    id="about-enquire"
    primaryHref="/contact"
    secondaryHref="/gallery"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>
