---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import { getContent } from "../lib/content/repository";

const { site } = getContent();
---

<BaseLayout
  title="About | Melbourne Photobooth Hire"
  description="About Melbourne Photobooth Hire — photobooth experiences for Melbourne events."
>
  <PageHeader
    title="About"
    eyebrow="The business"
    lede="Photobooth experiences for Melbourne events, handled by a dedicated local team."
  />
  <div class="readable section">
    <p>{site.serviceAreaStatement}</p>
    <p>
      About information will appear here once client-confirmed. Until then, please enquire for
      current details.
    </p>
    <p>
      <Button href="/contact" variant="primary">
        Enquire now
      </Button>
    </p>
  </div>
</BaseLayout>
