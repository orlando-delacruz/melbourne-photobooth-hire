---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveAboutSections from "../components/islands/LiveAboutSections";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// Raw CMS modules seed the story-image derivation in the live island.
const [{ serviceImages, ctaImage }, { pages: cmsPages }, liveModules, seo] = await Promise.all([
  loadPublicContent(),
  loadPublicPages(),
  loadPublicModules(),
  loadPublicSeo("about"),
]);
const aboutPage = cmsPages.about;
const headerImageSrc = serviceImages?.["roaming-photobooth"]?.src;
setPublicCache(Astro.response.headers);
---

<BaseLayout
  seoPageKey="about"
  title={seo.seoTitle || "About Us | Melbourne Photobooth Hire"}
  description={
    seo.seoDescription ||
    "Meet Melbourne Photobooth Hire, a local Melbourne team styling and running photobooth experiences for weddings, birthdays and corporate events."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
>
  <LivePageHeader
    client:visible
    pageKey="about"
    initial={aboutPage.header}
    imageSrc={headerImageSrc}
    imageAlt={serviceImages?.["roaming-photobooth"]?.alt}
  />

  <LiveAboutSections
    client:visible
    initialPage={aboutPage}
    initialGallery={liveModules.gallery}
    initialServices={liveModules.services}
  />

  <LiveCtaBand
    client:visible
    pageKey="about"
    initial={aboutPage.ctaBand}
    id="about-enquire"
    primaryHref="/contact"
    secondaryHref="/gallery"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>
