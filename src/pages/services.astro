---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { getContent } from "../lib/content/repository";

const { services } = getContent();
---

<BaseLayout
  title="Services | Melbourne Photobooth Hire"
  description="Premium, roaming and 360 photobooth experiences for Melbourne weddings, birthdays and corporate events."
>
  <h1>Our Booths</h1>
  <p>Melbourne&apos;s go-to photobooth hire — open-air and roaming setups for any event.</p>
  <ul>
    {services.map((service) => (
      <li>
        <h2>
          {service.name}
          {service.badge ? ` — ${service.badge}` : ""}
        </h2>
        <p>{service.summary}</p>
      </li>
    ))}
  </ul>
  <p>
    <Button href="/packages" variant="secondary">
      View packages
    </Button>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>
