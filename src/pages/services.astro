---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveServiceJump from "../components/islands/LiveServiceJump";
import LiveServiceSections from "../components/islands/LiveServiceSections";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// Raw CMS modules seed the live islands (DEC-033): the jump nav and the
// service sections patch themselves when the Services table changes.
const [{ services, serviceImages, ctaImage }, liveModules, { pages: cmsPages }, seo] =
  await Promise.all([
    loadPublicContent(),
    loadPublicModules(),
    loadPublicPages(),
    loadPublicSeo("services"),
  ]);
const servicesPage = cmsPages.services;
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImage = services[0] ? serviceImages?.[services[0].id] : undefined;
const headerImageSrc = headerImage?.src;
setPublicCache(Astro.response.headers);

// The three confirmed services, described as Service nodes linked to the
// business entity in the site graph (Phase 0, DEC-052). Anchors match the
// in-page service sections.
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const areaServed = [
  { "@type": "City", name: "Melbourne" },
  { "@type": "AdministrativeArea", name: "Victoria" },
];
const serviceSchema = services.map((service) => ({
  "@type": "Service",
  "@id": `${siteOrigin}/services#${service.id}`,
  name: service.name,
  serviceType: service.name,
  description: service.summary,
  url: `${siteOrigin}/services#${service.id}`,
  provider: { "@id": `${siteOrigin}/#localbusiness` },
  areaServed,
}));
---

<BaseLayout
  seoPageKey="services"
  title={seo.seoTitle || "Photobooth Hire Services Melbourne | Premium, Roaming & 360"}
  description={
    seo.seoDescription ||
    "Compare Melbourne photobooth hire services: open-air, roaming and 360 video booths for weddings, birthdays and corporate events, each styled and staffed."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={serviceSchema}
>
  <LivePageHeader
    client:visible
    pageKey="services"
    initial={servicesPage.header}
    imageSrc={headerImageSrc}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  >
    <LiveServiceJump client:visible initial={liveModules.services} />
  </LivePageHeader>

  <LiveServiceSections client:visible initial={liveModules.services} />

  <LiveCtaBand
    client:visible
    pageKey="services"
    initial={servicesPage.ctaBand}
    id="services-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>
