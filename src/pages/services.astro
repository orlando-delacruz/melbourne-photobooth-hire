---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import PageHeader from "../components/PageHeader.astro";
import Reveal from "../components/islands/Reveal";
import { getContent } from "../lib/content/repository";

const { services } = getContent();
---

<BaseLayout
  title="Services | Melbourne Photobooth Hire"
  description="Premium, roaming and 360 photobooth experiences for Melbourne weddings, birthdays and corporate events."
>
  <PageHeader
    title="Our Booths"
    eyebrow="Photobooth experiences"
    lede="Melbourne's go-to photobooth hire — open-air and roaming setups for any event."
  />
  <div class="card-grid section">
    {services.map((service) => (
      <Reveal client:visible>
        <Card
          title={service.name}
          badge={service.badge}
          icon={service.icon}
          tagline={service.tagline}
          description={service.summary}
          highlights={service.highlights}
          href="/packages"
          ctaLabel="View packages"
        />
      </Reveal>
    ))}
  </div>
  <p>
    <Button href="/packages" variant="secondary">
      View packages
    </Button>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
</BaseLayout>
