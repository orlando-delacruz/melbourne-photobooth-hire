---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import OccasionCrossLinks from "../components/OccasionCrossLinks.astro";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import LiveBoothSections from "../components/islands/LiveBoothSections";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { buildBreadcrumbList } from "../lib/seo";
import { setPublicCache } from "../lib/http-cache";

// Dedicated Weddings occasion page (SEO Track 2): distinct commercial intent
// (run-sheet timing, styling, guest flow) with unique client-confirmed copy.
// Reuses the booth content shape (steps, pricing, best-for, venue, FAQs) via
// the shared editor, schema and live sections — no new CMS machinery.
// Empty CMS rows render fallbacks and the island omits unfilled sections.
const [{ ctaImage, heroBackgroundImage }, liveModules, { pages: cmsPages }, seo] =
  await Promise.all([
    loadPublicContent(),
    loadPublicModules(),
    loadPublicPages(),
    loadPublicSeo("wedding"),
  ]);
const occasionPage = cmsPages.wedding;
const occasionFaqs = liveModules.faqs.filter((faq) => faq.highlight !== false).slice(0, 6);
// Header image is the likely LCP: the CMS header upload when set, else the
// brand home hero (occasions have no service-module row of their own).
const headerImage = occasionPage.header.image?.src
  ? occasionPage.header.image
  : heroBackgroundImage;
const headerImageSrc = headerImage?.src;
setPublicCache(Astro.response.headers);

const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Weddings", path: "/wedding-photobooth-melbourne" },
]);
---

<BaseLayout
  seoPageKey="wedding"
  title={seo.seoTitle || "Wedding Photobooth Melbourne | Photobooth Hire for Weddings"}
  description={
    seo.seoDescription ||
    "Hire a photobooth for your Melbourne wedding: styled open-air and 360 setups, instant prints, QR guest gallery and a team that runs the run-sheet with you."
  }
  ogImage={seo.ogImage.src || headerImageSrc || undefined}
  ogImageAlt={seo.ogImage.alt || headerImage?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? seo.ogImage.width : headerImage?.width}
  ogImageHeight={seo.ogImage.src ? seo.ogImage.height : headerImage?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={[breadcrumbSchema]}
>
  <LivePageHeader
    client:visible
    pageKey="wedding"
    initial={occasionPage.header}
    fallbackTitle="Photobooth hire for Melbourne weddings"
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/wedding-photobooth-melbourne", label: "Weddings" },
    ]}
    imageSrc={headerImageSrc}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  />

  <LiveBoothSections
    client:visible
    pageKey="wedding"
    initialPage={occasionPage}
    initialFaqs={occasionFaqs}
  />

  <OccasionCrossLinks
    siblingHref="/corporate-photobooth-melbourne"
    siblingLabel="Corporate events"
  />

  <LiveCtaBand
    client:visible
    pageKey="wedding"
    initial={occasionPage.ctaBand}
    id="occasion-wedding-enquire"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />
</BaseLayout>
