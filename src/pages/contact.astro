---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/islands/InquiryForm";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveContactAside from "../components/islands/LiveContactAside";
import { LiveContactCopyHead } from "../components/islands/LiveContactCopy";
import {
  loadPublicContent,
  loadPublicEventTypes,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
const [{ serviceImages }, { pages: cmsPages, settings: siteSettings }, eventTypeOptions, seo, modules] =
  await Promise.all([
    loadPublicContent(),
    loadPublicPages(),
    loadPublicEventTypes(),
    loadPublicSeo("contact"),
    loadPublicModules(),
  ]);
const contactPage = cmsPages.contact;
setPublicCache(Astro.response.headers);
// Contextual enquiry (DEC-036): a Service/Package card links to
// /contact?service=<slug> or ?package=<slug>. Resolve each slug against the
// public (highlighted) module rows independently; an unknown or absent slug
// simply leaves that dropdown on its placeholder.
const publicServices = modules.services.filter((service) => service.highlight !== false);
const publicPackages = modules.packages.filter((pkg) => pkg.highlight !== false);
const serviceSlug = Astro.url.searchParams.get("service");
const packageSlug = Astro.url.searchParams.get("package");
const initialService = publicServices.find((service) => service.id === serviceSlug)?.name ?? "";
const initialPackage = publicPackages.find((pkg) => pkg.id === packageSlug)?.name ?? "";
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImageSrc = serviceImages?.["roaming-photobooth"]?.src;
// Spam protection renders only when a site key is configured; the server
// verifies the token when its secret is set (see src/pages/api/inquiries.ts).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<BaseLayout
  seoPageKey="contact"
  title={seo.seoTitle || "Contact & Enquire | Photobooth Hire Melbourne"}
  description={
    seo.seoDescription ||
    "Enquire about photobooth hire in Melbourne. Send your event date, venue and guest numbers and we'll confirm availability and put together a clear quote."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
>
  <LivePageHeader
    client:visible
    pageKey="contact"
    initial={contactPage.header}
    imageSrc={headerImageSrc}
    imageAlt={serviceImages?.["roaming-photobooth"]?.alt}
  />

  <section class="section contact" aria-labelledby="contact-form-heading">
    <div class="contact-grid">
      <div class="form-card">
        <header class="form-head">
          <span class="form-icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </span>
          <LiveContactCopyHead client:visible initialPage={contactPage} />
        </header>
        <InquiryForm
          client:visible
          eventTypes={eventTypeOptions}
          turnstileSiteKey={turnstileSiteKey}
          services={publicServices}
          packages={publicPackages}
          initialService={initialService || undefined}
          initialPackage={initialPackage || undefined}
        />
      </div>

      <LiveContactAside client:visible initialPage={contactPage} initialSettings={siteSettings} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
  }
  /* Single column: the form leads and the details panel sits beneath it,
     kept to a comfortable reading measure and centred on the page. */
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    max-width: 48rem;
    margin-inline: auto;
  }

  .form-card {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .form-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-line), transparent);
    pointer-events: none;
  }

  /* Icon centred on the title line; the lede sits under the title, aligned
     with the title's left edge. The heading and lede are island-rendered, so
     scoped styles cannot reach them — :global() targets them from this
     scoped parent. */
  .form-head {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-sm);
    row-gap: var(--space-3xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-divider);
  }
  .form-icon {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-accent-line);
    background: color-mix(in srgb, var(--color-accent-wash) 55%, var(--color-ivory));
    color: var(--color-accent-strong);
  }
  .form-head :global(h2) {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-size: var(--text-h2);
  }
  .form-head :global(p) {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
</style>
