---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/islands/InquiryForm";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveContactAside from "../components/islands/LiveContactAside";
import { LiveContactCopyFoot, LiveContactCopyHead } from "../components/islands/LiveContactCopy";
import {
  loadPublicContent,
  loadPublicEventTypes,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { setPublicCache } from "../lib/http-cache";
import "../styles/inquiry-form.css";

const { serviceImages } = await loadPublicContent();
const { pages: cmsPages, settings: siteSettings } = await loadPublicPages();
const contactPage = cmsPages.contact;
const eventTypeOptions = await loadPublicEventTypes();
const seo = await loadPublicSeo("contact");
setPublicCache(Astro.response.headers);
// Spam protection renders only when a site key is configured; the server
// verifies the token when its secret is set (see src/pages/api/inquiries.ts).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<BaseLayout
  seoPageKey="contact"
  title={seo.seoTitle || "Contact & Enquire | Photobooth Hire Melbourne"}
  description={
    seo.seoDescription ||
    "Enquire about photobooth hire in Melbourne. Send your event date, venue and guest numbers and we'll confirm availability and put together a clear quote."
  }
  ogImage={seo.ogImage.src || undefined}
  ogImageAlt={seo.ogImage.alt || undefined}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
>
  <LivePageHeader
    client:visible
    pageKey="contact"
    initial={contactPage.header}
    imageSrc={serviceImages?.["roaming-photobooth"]?.src}
    imageAlt={serviceImages?.["roaming-photobooth"]?.alt}
  />

  <section class="section contact" aria-labelledby="contact-form-heading">
    <LiveContactAside client:visible initialPage={contactPage} initialSettings={siteSettings} />

    <div class="form-card">
      <header class="form-head">
        <span class="form-icon" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <div>
          <LiveContactCopyHead client:visible initialPage={contactPage} />
        </div>
      </header>
      <InquiryForm
        client:visible
        eventTypes={eventTypeOptions}
        turnstileSiteKey={turnstileSiteKey}
      />
      {turnstileSiteKey ? (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      ) : null}
      <LiveContactCopyFoot client:visible initialPage={contactPage} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .form-card {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--elevation-2);
  }
  .form-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-line), transparent);
    pointer-events: none;
  }
  .form-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-divider);
  }
  .form-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
    color: var(--color-accent-strong);
  }
  .form-head h2 {
    margin: 0 0 var(--space-3xs);
    font-size: var(--text-h2);
  }
  .form-head p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
  .form-foot {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-divider);
    color: var(--color-ink-faint);
    font-size: var(--text-small);
  }

  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--space-2xl);
    }
  }
</style>
