---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbList } from "../lib/seo";
import InquiryForm from "../components/islands/InquiryForm";
import LivePageHeader from "../components/islands/LivePageHeader";
import LiveContactAside from "../components/islands/LiveContactAside";
import { LiveContactCopyHead } from "../components/islands/LiveContactCopy";
import {
  loadPublicContent,
  loadPublicEventTypes,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
const [{ serviceImages }, { pages: cmsPages, settings: siteSettings }, eventTypeOptions, seo, modules] =
  await Promise.all([
    loadPublicContent(),
    loadPublicPages(),
    loadPublicEventTypes(),
    loadPublicSeo("contact"),
    loadPublicModules(),
  ]);
const contactPage = cmsPages.contact;
setPublicCache(Astro.response.headers);
// Contextual enquiry (DEC-036): a Service/Package card links to
// /contact?service=<slug> or ?package=<slug>. Resolve each slug against the
// public (highlighted) module rows independently; an unknown or absent slug
// simply leaves that dropdown on its placeholder.
const publicServices = modules.services.filter((service) => service.highlight !== false);
const publicPackages = modules.packages.filter((pkg) => pkg.highlight !== false);
const serviceSlug = Astro.url.searchParams.get("service");
const packageSlug = Astro.url.searchParams.get("package");
const initialService = publicServices.find((service) => service.id === serviceSlug)?.name ?? "";
const initialPackage = publicPackages.find((pkg) => pkg.id === packageSlug)?.name ?? "";
// Page-header image is the likely LCP on this route; preload it (see head).
const headerImage = serviceImages?.["roaming-photobooth"];
const headerImageSrc = headerImage?.src;
// Spam protection renders only when a site key is configured; the server
// verifies the token when its secret is set (see src/pages/api/inquiries.ts).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const siteOrigin = (Astro.site ?? new URL("https://www.melbournephotoboothhire.com.au")).origin;
const breadcrumbSchema = buildBreadcrumbList(siteOrigin, [
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact" },
]);
---

<BaseLayout
  seoPageKey="contact"
  title={seo.seoTitle || "Contact & Enquire | Photobooth Hire Melbourne"}
  description={
    seo.seoDescription ||
    "Enquire about photobooth hire in Melbourne. Send your event date, venue and guest numbers and we'll confirm availability and put together a clear quote."
  }
  ogImage={seo.ogImage.src || headerImageSrc || undefined}
  ogImageAlt={seo.ogImage.alt || headerImage?.alt || undefined}
  ogImageWidth={seo.ogImage.src ? seo.ogImage.width : headerImage?.width}
  ogImageHeight={seo.ogImage.src ? seo.ogImage.height : headerImage?.height}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={headerImageSrc}
  preloadImageSrcSet={imageSrcSet(headerImage)}
  preloadImageSizes="100vw"
  structuredData={[breadcrumbSchema]}
>
  <LivePageHeader
    client:visible
    pageKey="contact"
    initial={contactPage.header}
    breadcrumbs={[{ href: "/", label: "Home" }, { href: "/contact", label: "Contact" }]}
    imageSrc={headerImageSrc}
    imageAlt={headerImage?.alt}
    imageSrcSet={imageSrcSet(headerImage)}
    imageWidth={headerImage?.width}
    imageHeight={headerImage?.height}
  />

  <section class="section contact" aria-labelledby="contact-form-heading">
    <div class="contact-grid">
      <div class="form-card">
        <header class="form-head">
          <span class="form-icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </span>
          <LiveContactCopyHead client:visible initialPage={contactPage} />
        </header>
        <InquiryForm
          client:visible
          eventTypes={eventTypeOptions}
          turnstileSiteKey={turnstileSiteKey}
          services={publicServices}
          packages={publicPackages}
          initialService={initialService || undefined}
          initialPackage={initialPackage || undefined}
        />
      </div>

      <LiveContactAside client:visible initialPage={contactPage} initialSettings={siteSettings} />
    </div>
    <nav class="contact-links" aria-label="Related pages">
      <p class="contact-links-lead">Not sure which booth fits?</p>
      <ul>
        <li>
          <a href="/services">
            <span>Compare our photobooth services</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </li>
        <li>
          <a href="/packages">
            <span>View packages and pricing</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
  }
  /* Single column: the form leads and the details panel sits beneath it,
     kept to a comfortable reading measure and centred on the page. */
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    max-width: 48rem;
    margin-inline: auto;
  }

  /* Quiet cross-link trail below the enquiry form. Mirrors the gallery and
     booth-page cross-links: a champagne hairline, a soft lead line and arrow
     links in the accent colour — secondary navigation, not a competing CTA. */
  .contact-links {
    position: relative;
    max-width: 44rem;
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-lg);
    text-align: center;
  }
  .contact-links::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-line),
      transparent
    );
    pointer-events: none;
  }
  .contact-links-lead {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead);
    color: var(--color-ink);
  }
  .contact-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
  }
  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding-block: 0.35rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .contact-links a svg {
    transition: transform var(--motion-quick) var(--ease-default);
  }
  .contact-links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .contact-links a:hover svg {
    transform: translateX(3px);
  }
  .contact-links a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-links a,
    .contact-links a svg {
      transition: none;
    }
    .contact-links a:hover svg {
      transform: none;
    }
  }

  .form-card {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .form-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-line), transparent);
    pointer-events: none;
  }

  /* Icon centred on the title line; the lede sits under the title, aligned
     with the title's left edge. The heading and lede are island-rendered, so
     scoped styles cannot reach them — :global() targets them from this
     scoped parent. */
  .form-head {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-sm);
    row-gap: var(--space-3xs);
    align-items: center;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-divider);
  }
  .form-icon {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-accent-line);
    background: color-mix(in srgb, var(--color-accent-wash) 55%, var(--color-ivory));
    color: var(--color-accent-strong);
  }
  .form-head :global(h2) {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-size: var(--text-h2);
  }
  .form-head :global(p) {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
</style>
