---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="Melbourne Photobooth Hire | Photobooth Hire for Melbourne Events"
  description="Melbourne Photobooth Hire — photobooth experiences for Melbourne events. Structure-only homepage; final copy pending client confirmation."
>
  <h1>Melbourne Photobooth Hire</h1>
  <p>Structure-only homepage. Final copy pending client confirmation.</p>
  <p>
    <Button href="/contact" variant="primary">
      Enquire now
    </Button>
  </p>
  <section aria-labelledby="explore-heading">
    <SectionHeading title="Explore" id="explore-heading" />
    <p>
      <Button href="/services" variant="secondary">
        Explore services
      </Button>
      <Button href="/packages" variant="secondary">
        View packages
      </Button>
      <Button href="/gallery" variant="secondary">
        View gallery
      </Button>
      <Button href="/faq" variant="secondary">
        Read FAQ
      </Button>
    </p>
  </section>
</BaseLayout>
