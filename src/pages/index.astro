---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import LiveServicesSection from "../components/islands/LiveServicesSection";
import LiveShowcaseSection from "../components/islands/LiveShowcaseSection";
import LivePackagesSection from "../components/islands/LivePackagesSection";
import LiveFaqTeaser from "../components/islands/LiveFaqTeaser";
import LiveSteps from "../components/islands/LiveSteps";
import LiveMarquee from "../components/islands/LiveMarquee";
import LiveCtaBand from "../components/islands/LiveCtaBand";
import {
  loadPublicContent,
  loadPublicModules,
  loadPublicSeo,
  loadPublicPages,
} from "../lib/supabase/public";
import { heroStatValue } from "../lib/content/heroStats";
import { imageSrcSet } from "../lib/images";
import { setPublicCache } from "../lib/http-cache";

// Independent loads run in parallel to keep server response time low (LCP).
// Raw CMS modules seed the live islands (DEC-033); each island patches its
// section when its table changes, with no page refresh. Testimonials fall
// back to the legacy home blob until the module holds items (DEC-034).
const [
  { heroBackgroundImage, ctaImage },
  liveModules,
  { pages: cmsPages, settings: siteSettings },
  seo,
] = await Promise.all([
  loadPublicContent(),
  loadPublicModules(),
  loadPublicPages(),
  loadPublicSeo("home"),
]);
const home = cmsPages.home;
// Module rows are the source of truth; the deprecated home-blob fallback
// predates moderation and was always public, so it reads as approved.
const liveTestimonials =
  liveModules.testimonials.length > 0
    ? liveModules.testimonials
    : home.testimonials.map((item) => ({ ...item, status: "approved" as const }));
// Preload the actual hero render target: the CMS hero image when set, else the
// mock fallback. Preloading the fallback while the CMS image renders (the
// previous behaviour) wasted the request and left the real LCP undiscovered.
const heroPreloadSrc = home.hero.background?.src || heroBackgroundImage?.src;
// OG social image (OG = hero rule): CMS OG image first, else the hero
// background actually rendered above. Dimensions follow the same chain.
const ogHero = home.hero.background?.src ? home.hero.background : heroBackgroundImage;
const ogImageSrc = seo.ogImage.src || ogHero?.src || undefined;
const ogImageAltText = seo.ogImage.alt || ogHero?.alt || undefined;
// Dimensions describe the resolved image: stored SEO dims win, else the
// hero fallback dims (SEO rows previously stored no dims).
const ogImageWidth = seo.ogImage.src ? seo.ogImage.width : ogHero?.width;
const ogImageHeight = seo.ogImage.src ? seo.ogImage.height : ogHero?.height;
// Derived hero stat values resolved at render (the hero is static markup).
const heroStats = home.hero.stats.map((stat) => ({
  ...stat,
  value: heroStatValue(stat, liveModules.services, liveModules.packages),
}));
// Spam protection renders only when a site key is configured; the server
// verifies the token when its secret is set (see src/pages/api/reviews.ts).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const reviewConfig = {
  eventTypes: liveModules["event-types"].map((item) => item.label),
  ...(turnstileSiteKey ? { turnstileSiteKey } : {}),
};
setPublicCache(Astro.response.headers);
// Content islands hydrate only once scrolled into the upper part of the
// viewport, so react-dom stays off the initial mobile load (DEC-050).
const DEFERRED = { rootMargin: "0px 0px -20% 0px" };
---

<BaseLayout
  seoPageKey="home"
  bodyClass="page-home"
  title={seo.seoTitle || "Photobooth Hire Melbourne | Melbourne Photobooth Hire"}
  description={
    seo.seoDescription ||
    "Photobooth hire in Melbourne for weddings, birthdays, corporate and school events. Open-air, roaming and 360 booths with HD prints and instant QR downloads."
  }
  ogImage={ogImageSrc}
  ogImageAlt={ogImageAltText}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  canonicalUrl={seo.canonicalUrl || undefined}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogTitle={seo.ogTitle || undefined}
  ogDescription={seo.ogDescription || undefined}
  preloadImage={heroPreloadSrc}
  preloadImageSrcSet={imageSrcSet(home.hero.background)}
  preloadImageSizes="100vw"
>
  <Hero
    eyebrow={home.hero.eyebrow}
    headline={home.hero.headline}
    supporting={home.hero.supporting}
    primaryHref="/contact"
    primaryLabel={home.hero.primaryLabel}
    secondaryHref="/packages"
    secondaryLabel={home.hero.secondaryLabel}
    backgroundSrc={home.hero.background?.src || heroBackgroundImage?.src}
    backgroundAlt={home.hero.background?.alt || heroBackgroundImage?.alt}
    backgroundSrcSet={imageSrcSet(home.hero.background)}
    backgroundWidth={home.hero.background?.width}
    backgroundHeight={home.hero.background?.height}
    stats={heroStats}
    scrollHref="#packages-heading"
    scrollLabel="Scroll to our packages"
  />

  <TrustStrip initialSettings={siteSettings} initialEventTypes={liveModules["event-types"]} />

  <LivePackagesSection
    client:visible={DEFERRED}
    initial={liveModules.packages}
    initialHome={{
      packagesHeading: home.packagesHeading,
      packagesCompareLabel: home.packagesCompareLabel,
    }}
  />

  <LiveServicesSection
    client:visible={DEFERRED}
    initial={liveModules.services}
    initialHome={{ servicesHeading: home.servicesHeading }}
  />

  <LiveShowcaseSection
    client:visible={DEFERRED}
    initial={liveModules.gallery.filter((item) => item.highlight !== false)}
    initialHome={{
      showcaseHeading: home.showcaseHeading,
      showcaseLabel: home.showcaseLabel,
    }}
  />

  <LiveMarquee
    client:visible={DEFERRED}
    initial={liveTestimonials}
    initialHome={{ reviewsHeading: home.reviewsHeading }}
  />

  <LiveFaqTeaser
    client:visible={DEFERRED}
    initial={liveModules.faqs}
    initialHome={{ faqHeading: home.faqHeading, faqCtaLabel: home.faqCtaLabel }}
  />

  <LiveSteps
    client:visible={DEFERRED}
    initialHome={{ processHeading: home.processHeading, steps: home.steps }}
  />

  <LiveCtaBand
    client:visible={DEFERRED}
    pageKey="home"
    initial={home.ctaBand}
    id="enquire-heading"
    primaryHref="/contact"
    secondaryHref="/packages"
    fallbackImageSrc={ctaImage?.src}
    fallbackImageAlt={ctaImage?.alt}
  />

  <script
    type="application/json"
    id="review-config"
    is:inline
    set:html={JSON.stringify(reviewConfig)}
  ></script>
</BaseLayout>
