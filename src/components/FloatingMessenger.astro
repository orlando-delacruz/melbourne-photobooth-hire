---
/**
 * Floating Messenger CTA (DEC-050).
 *
 * Static SSR markup (no React) so it never pulls react-dom onto the initial
 * load. The destination comes from CMS Site Settings and is kept live by the
 * shared vanilla chrome runtime via `data-live-section` (the whole anchor is
 * replaced, so the href updates too). The documented placeholder is
 * m.me/<page-username>; a real username must be set before production
 * (see docs/DECISIONS.md, DEC-014).
 */
import type { SiteSettingsContent } from "../lib/cms/types";

interface Props {
  initialSettings: SiteSettingsContent;
}
const { initialSettings } = Astro.props;

const CHAT_SVG =
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><path d="M8.5 11.5h.01"/><path d="M12 11.5h.01"/><path d="M15.5 11.5h.01"/></svg>';
---

{initialSettings.messengerUrl ? (
  <a
    class="floating-messenger"
    href={initialSettings.messengerUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on Facebook Messenger (opens in a new tab)"
    data-live-section="messenger"
    data-ga-messenger="true"
    data-ga-location="floating_messenger"
  >
    <span class="fm-ring" aria-hidden="true" />
    <span class="fm-icon" aria-hidden="true" set:html={CHAT_SVG} />
    <span class="fm-label" aria-hidden="true">
      Chat with us
    </span>
  </a>
) : null}
