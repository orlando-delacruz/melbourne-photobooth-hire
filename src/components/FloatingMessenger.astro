---
/**
 * Floating Messenger CTA.
 *
 * Destination comes from the CMS Site Settings (messengerUrl). The default
 * below is a documented placeholder for the client's Facebook Page username
 * (m.me/<page-username>). No Facebook/Messenger integration is confirmed in
 * docs/ yet; a real username must be set before production
 * (see docs/DECISIONS.md, DEC-014).
 */
interface Props {
  messengerUrl?: string;
}
const { messengerUrl = "https://m.me/" } = Astro.props;

const chattingSvg = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><path d="M8.5 11.5h.01"/><path d="M12 11.5h.01"/><path d="M15.5 11.5h.01"/></svg>`;
---

<a
  class="floating-messenger"
  href={messengerUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on Facebook Messenger (opens in a new tab)"
>
  <span class="fm-ring" aria-hidden="true"></span>
  <span class="fm-icon" set:html={chattingSvg} />
  <span class="fm-label" aria-hidden="true">
    Chat with us
  </span>
</a>

<style>
  .floating-messenger {
    position: fixed;
    right: calc(var(--space-md) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    z-index: 45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-on-dark);
    color: var(--color-ink);
    border: 1px solid rgba(23, 18, 12, 0.12);
    box-shadow: var(--elevation-2);
    text-decoration: none;
    isolation: isolate;
    animation: fm-in 620ms var(--ease-default) 700ms both;
    transition:
      transform var(--motion-quick) var(--ease-default),
      box-shadow var(--motion-quick) var(--ease-default),
      background-color var(--motion-quick) var(--ease-default);
  }
  .floating-messenger:hover {
    transform: translateY(-3px) scale(1.04);
    background: #f0dca6;
    box-shadow: var(--elevation-3);
  }
  .floating-messenger:active {
    transform: translateY(-1px) scale(1);
  }
  .fm-icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    line-height: 0;
  }

  /* Slow exhalation ring: signals availability without shouting. */
  .fm-ring {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    border: 1px solid var(--color-accent-on-dark);
    animation: fm-pulse 3.4s var(--ease-soft) infinite 1.6s;
    pointer-events: none;
  }

  .fm-label {
    position: absolute;
    right: calc(100% + var(--space-xs));
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    white-space: nowrap;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-ink);
    border: 1px solid var(--color-ink-hairline-strong);
    font-size: var(--text-small);
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--motion-quick) var(--ease-default),
      transform var(--motion-quick) var(--ease-default);
  }
  .floating-messenger:hover .fm-label,
  .floating-messenger:focus-visible .fm-label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @keyframes fm-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.86);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes fm-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.5);
      opacity: 0;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* The mobile menu panel owns the viewport while it is open. */
  :global(html[data-menu-open="true"]) .floating-messenger {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-quick) var(--ease-default);
  }

  @media (max-width: 639px) {
    .floating-messenger {
      width: 54px;
      height: 54px;
    }
    .fm-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-messenger {
      animation: none;
    }
    .fm-ring {
      animation: none;
      opacity: 0;
    }
    .floating-messenger:hover {
      transform: none;
    }
  }
</style>
