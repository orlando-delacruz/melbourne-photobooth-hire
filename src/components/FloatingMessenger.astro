---
/**
 * Floating Messenger CTA.
 *
 * Destination comes from the CMS Site Settings (messengerUrl) and stays
 * live through the settings subscription. The documented placeholder is
 * m.me/<page-username>; a real username must be set before production
 * (see docs/DECISIONS.md, DEC-014).
 */
import LiveMessengerLink from "./islands/LiveMessengerLink";
import type { SiteSettingsContent } from "../lib/cms/types";

interface Props {
  initialSettings: SiteSettingsContent;
}
const { initialSettings } = Astro.props;
---

<LiveMessengerLink client:visible initialSettings={initialSettings} />
