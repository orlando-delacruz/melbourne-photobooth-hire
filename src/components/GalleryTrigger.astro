---
/**
 * A gallery image wrapped in a real link. The link is the progressive-enhancement
 * fallback (it opens the full image on its own); the GalleryLightbox island
 * upgrades the click into an accessible dialog on pages that mount it.
 */
interface Props {
  src: string;
  caption?: string;
  class?: string;
}
const { src, caption, class: className } = Astro.props;

const eyeSvg = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>`;
---

<a
  class:list={["gallery-trigger", className]}
  href={src}
  data-lightbox
  data-full={src}
  data-caption={caption}
>
  <slot />
  <span class="gallery-trigger-view" aria-hidden="true" set:html={eyeSvg} />
  <span class="sr-only">View full size</span>
</a>
<style>
  .gallery-trigger {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .gallery-trigger-view {
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-pill);
    background: rgba(13, 9, 6, 0.58);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(244, 238, 224, 0.34);
    color: var(--color-on-ink);
    opacity: 0;
    transform: scale(0.82);
    transition:
      opacity var(--motion-settled) var(--ease-default),
      transform var(--motion-settled) var(--ease-default);
    pointer-events: none;
  }
  .gallery-trigger:hover .gallery-trigger-view,
  .gallery-trigger:focus-visible .gallery-trigger-view {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: none) {
    .gallery-trigger-view {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-trigger-view {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
