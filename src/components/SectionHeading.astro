---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  id?: string;
  tone?: "light" | "dark";
  align?: "start" | "center";
  size?: "md" | "lg";
  /** Draw the champagne rule before the eyebrow. */
  rule?: boolean;
}
const {
  title,
  eyebrow,
  lede,
  id,
  tone = "light",
  align = "start",
  size = "md",
  rule = true,
} = Astro.props;
---

<div
  class:list={[
    "section-heading",
    `section-heading--${tone}`,
    `section-heading--${align}`,
    `section-heading--${size}`,
    { "on-dark": tone === "dark" },
  ]}
>
  {eyebrow ? <p class:list={["eyebrow", { "eyebrow--rule": rule }]}>{eyebrow}</p> : null}
  <h2 id={id}>{title}</h2>
  {lede ? <p class="lede">{lede}</p> : null}
</div>
<style>
  .section-heading {
    max-width: var(--text-max-width);
    margin-bottom: var(--space-lg);
  }
  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }
  .section-heading--center .eyebrow {
    justify-content: center;
  }
  .section-heading h2 {
    margin: var(--space-sm) 0 var(--space-xs);
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }
  .section-heading--lg h2 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
  }
  .lede {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-lead);
    font-weight: 400;
  }
  .section-heading--dark h2 {
    color: var(--color-on-ink);
  }
  .section-heading--dark .lede {
    color: var(--color-on-ink-secondary);
  }
</style>
