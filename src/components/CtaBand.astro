---
import Button from "./Button.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  lede?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  imageSrc?: string;
  imageAlt?: string;
  id?: string;
}
const {
  eyebrow,
  headline,
  lede,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  imageSrc,
  imageAlt,
  id,
} = Astro.props;
---

<section class="cta-band bleed on-dark" aria-labelledby={id}>
  {imageSrc ? (
    <div
      class="cta-band__media"
      style={`background-image: url('${imageSrc}')`}
      aria-hidden="true"
    />
  ) : null}
  <div class="cta-band__scrim" aria-hidden="true"></div>
  {imageSrc && imageAlt ? <span class="sr-only">{imageAlt}</span> : null}
  <div class="container cta-band__inner">
    {eyebrow ? <p class="eyebrow eyebrow--rule">{eyebrow}</p> : null}
    <h2 id={id}>{headline}</h2>
    {lede ? <p class="cta-band__lede">{lede}</p> : null}
    <p class="cta-band__buttons">
      <Button href={primaryHref} variant="primary" tone="dark" size="lg" arrow>
        {primaryLabel}
      </Button>
      {secondaryHref && secondaryLabel ? (
        <Button href={secondaryHref} variant="secondary" tone="dark" size="lg">
          {secondaryLabel}
        </Button>
      ) : null}
    </p>
  </div>
</section>
<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-ink-deep);
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--color-ink-hairline);
    text-align: center;
  }
  .cta-band__media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: -2;
  }
  .cta-band__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(100% 120% at 50% 0%, rgba(230, 206, 138, 0.16), transparent 60%),
      linear-gradient(180deg, rgba(13, 9, 6, 0.72) 0%, rgba(13, 9, 6, 0.9) 100%);
  }
  .cta-band__inner {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .cta-band h2 {
    margin: var(--space-sm) 0 0;
    max-width: 20ch;
    color: var(--color-on-ink);
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }
  .cta-band__lede {
    margin: var(--space-sm) 0 0;
    max-width: 46ch;
    color: var(--color-on-ink-secondary);
    font-size: var(--text-lead);
  }
  .cta-band__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
    margin: var(--space-lg) 0 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
