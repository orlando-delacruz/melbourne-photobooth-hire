---
import type { NavItem } from "./islands/MobileNav";
import LiveBrandLogo from "./islands/LiveBrandLogo";
import LiveBrandName from "./islands/LiveBrandName";
import { LiveFooterBase, LiveFooterBrand, LiveFooterCta } from "./islands/LiveFooterPanels";
import type { SiteSettingsContent } from "../lib/cms/types";

interface Props {
  items: NavItem[];
  initialSettings: SiteSettingsContent;
}
const { items, initialSettings } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-top">
    <div class="footer-brand">
      <LiveBrandLogo client:idle initialSettings={initialSettings} />
      <p class="brand-name">
        <span class="brand-mark" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
            <circle cx="12" cy="12" r="3.4" />
            <path d="M7.5 5.5 9 3.2h6l1.5 2.3" />
          </svg>
        </span>
        <LiveBrandName client:idle initialSettings={initialSettings} />
      </p>
      <LiveFooterBrand client:idle initialSettings={initialSettings} />
    </div>
    <nav class="footer-nav" aria-label="Explore">
      <h2>Explore</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="footer-nav" aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        <li>
          <a href="/privacy">Privacy Policy</a>
        </li>
        <li>
          <a href="/terms">Terms &amp; Conditions</a>
        </li>
      </ul>
    </nav>
    <div class="footer-cta">
      <LiveFooterCta client:idle initialSettings={initialSettings} />
    </div>
  </div>
  <div class="container footer-base">
    <LiveFooterBase client:idle initialSettings={initialSettings} />
  </div>
</footer>
<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-ink);
    padding-block: clamp(3rem, 6vw, 5rem) var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-coral),
      var(--color-accent-line-strong) 55%,
      transparent
    );
  }
  .footer-glow {
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: radial-gradient(90% 120% at 15% 120%, var(--color-accent-wash), transparent 70%);
    pointer-events: none;
  }
  .footer-top {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .footer-brand :global(.brand-logo) {
    margin-bottom: var(--space-sm);
  }
  .brand-name {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-xs);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }
  .brand-mark {
    display: inline-flex;
    color: var(--color-accent-strong);
  }
  .footer-nav h2 {
    margin: 0 0 var(--space-sm);
    padding-bottom: var(--space-3xs);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .footer-nav h2::after {
    content: "";
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-3xs);
    border-radius: var(--radius-pill);
    background: var(--color-coral);
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .footer-nav a {
    position: relative;
    display: inline-block;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .footer-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-settled) var(--ease-default);
  }
  .footer-nav a:hover {
    color: var(--color-accent-strong);
  }
  .footer-nav a:hover::after {
    transform: scaleX(1);
  }
  .footer-cta {
    background: var(--color-ivory);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-coral);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-md) var(--space-lg);
    box-shadow: var(--elevation-1);
    align-self: start;
  }
  .footer-base {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    justify-content: space-between;
    align-items: baseline;
  }
  @media (min-width: 720px) {
    .footer-top {
      grid-template-columns: 1.6fr 0.8fr 0.8fr;
    }
    .footer-cta {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .footer-top {
      grid-template-columns: 1.5fr 0.8fr 0.8fr 1.2fr;
      align-items: start;
    }
    .footer-cta {
      grid-column: auto;
    }
  }
</style>
