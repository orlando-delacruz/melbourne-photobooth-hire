---
import type { NavItem } from "./islands/MobileNav";

interface Props {
  items: NavItem[];
  brandName: string;
  serviceAreaStatement: string;
  reviewUrl: string | null;
}
const { items, brandName, serviceAreaStatement, reviewUrl } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="brand-name">{brandName}</p>
      <p class="brand-statement">{serviceAreaStatement}</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/privacy">Privacy Policy</a>
        </li>
        <li>
          <a href="/terms">Terms &amp; Conditions</a>
        </li>
      </ul>
    </nav>
    {reviewUrl ? (
      <p class="footer-review">
        <a href={reviewUrl}>Leave a Google review</a>
      </p>
    ) : null}
  </div>
</footer>
<style>
  .site-footer {
    margin-top: var(--space-xl);
    background: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: var(--space-lg);
    border-top: 1px solid rgba(227, 201, 138, 0.18);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }
  .brand-name {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-on-ink);
  }
  .brand-statement {
    margin: 0;
    color: var(--color-on-ink-secondary);
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }
  .footer-nav a {
    color: var(--color-on-ink);
    text-decoration: none;
    padding: var(--space-2xs) 0;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .footer-nav a:hover {
    color: var(--color-accent-on-dark);
  }
  .footer-review {
    margin: 0;
  }
  .footer-review a {
    color: var(--color-accent-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
    .footer-review {
      grid-column: 1 / -1;
    }
  }
</style>
