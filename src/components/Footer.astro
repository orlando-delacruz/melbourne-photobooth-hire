---
import type { NavItem } from "../lib/navigation";
import type { SiteSettingsContent } from "../lib/cms/types";
import SocialIcon from "./SocialIcon.astro";
import Button from "./Button.astro";
import { ENQUIRY_HREF } from "../lib/navigation";
import { imageSrcSet } from "../lib/images";

interface Props {
  items: NavItem[];
  initialSettings: SiteSettingsContent;
}
const { items, initialSettings } = Astro.props;
const logo = initialSettings.logo;
const logoSrcSet = logo ? imageSrcSet(logo) : undefined;
const socials = initialSettings.socials ?? [];
const phones = [initialSettings.phonePrimary, initialSettings.phoneSecondary].filter(
  (phone): phone is string => Boolean(phone && phone.trim()),
);
const credentials = [
  initialSettings.abn ? `ABN ${initialSettings.abn}` : null,
  ...(initialSettings.trustItems ?? []).filter((item) => item && item.trim()),
].filter((item): item is string => Boolean(item));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-top">
    <div class="footer-brand" data-live-section="footer-brand">
      {logo?.src ? (
        <img
          class="brand-logo"
          src={logo.src}
          srcset={logoSrcSet}
          sizes={logoSrcSet ? "120px" : undefined}
          alt={logo.alt || initialSettings.brandName}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      ) : null}
      <p class="brand-name">
        <span class="brand-mark" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
            <circle cx="12" cy="12" r="3.4" />
            <path d="M7.5 5.5 9 3.2h6l1.5 2.3" />
          </svg>
        </span>
        {initialSettings.brandName}
      </p>
      <p class="brand-statement">{initialSettings.serviceAreaStatement}</p>
      {phones.length > 0 ? (
        <p class="footer-contact">
          {phones.map((phone, index) => (
            <span>
              {index > 0 ? " · " : null}
              <a href={`tel:${phone.replace(/[\s()]/g, "")}`}>{phone}</a>
            </span>
          ))}
        </p>
      ) : null}
      {initialSettings.contactEmail ? (
        <p class="footer-contact">
          <a href={`mailto:${initialSettings.contactEmail}`}>{initialSettings.contactEmail}</a>
        </p>
      ) : null}
      {initialSettings.transportNote ? (
        <p class="footer-contact">{initialSettings.transportNote}</p>
      ) : null}
      {initialSettings.reviewUrl ? (
        <p class="footer-review">
          <a href={initialSettings.reviewUrl}>Leave a Google review</a>
        </p>
      ) : null}
      {socials.length > 0 ? (
        <div class="footer-social">
          <h2>Follow</h2>
          <ul>
            {socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${initialSettings.brandName} on ${social.label} (opens in a new tab)`}
                >
                  <SocialIcon label={social.label} />
                  <span>{social.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null}
    </div>
    <nav class="footer-nav" aria-label="Explore">
      <h2>Explore</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="footer-nav" aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        <li>
          <a href="/privacy">Privacy Policy</a>
        </li>
        <li>
          <a href="/terms">Terms &amp; Conditions</a>
        </li>
      </ul>
    </nav>
    <div class="footer-cta" data-live-section="footer-cta">
      <h2>{initialSettings.footerCta.title}</h2>
      <p>{initialSettings.footerCta.lede}</p>
      <Button href={ENQUIRY_HREF} variant="primary" tone="light" size="lg" arrow>
        {initialSettings.footerCta.label}
      </Button>
    </div>
  </div>
  <div class="container footer-base" data-live-section="footer-base">
    <p class="footer-copy">
      &copy; {year} {initialSettings.brandName}. All rights reserved.
    </p>
    <p class="footer-area">
      {initialSettings.serviceAreaStatement}
      {credentials.length > 0 ? ` · ${credentials.join(" · ")}` : null}
    </p>
  </div>
</footer>
<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-ink);
    padding-block: clamp(3rem, 6vw, 5rem) var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-coral),
      var(--color-accent-line-strong) 55%,
      transparent
    );
  }
  .footer-glow {
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: radial-gradient(90% 120% at 15% 120%, var(--color-accent-wash), transparent 70%);
    pointer-events: none;
  }
  .footer-top {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  .footer-brand :global(.brand-logo) {
    margin-bottom: var(--space-sm);
  }
  .brand-name {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-xs);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }
  .brand-mark {
    display: inline-flex;
    color: var(--color-accent-strong);
  }
  .footer-nav h2 {
    margin: 0 0 var(--space-sm);
    padding-bottom: var(--space-3xs);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .footer-nav h2::after {
    content: "";
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-3xs);
    border-radius: var(--radius-pill);
    background: var(--color-coral);
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .footer-nav a {
    position: relative;
    display: inline-block;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .footer-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-settled) var(--ease-default);
  }
  .footer-nav a:hover {
    color: var(--color-accent-strong);
  }
  .footer-nav a:hover::after {
    transform: scaleX(1);
  }
  .footer-cta {
    background: var(--color-ivory);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-coral);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-md) var(--space-lg);
    box-shadow: var(--elevation-1);
    align-self: start;
  }
  .footer-base {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    justify-content: space-between;
    align-items: baseline;
  }
  @media (min-width: 720px) {
    .footer-top {
      grid-template-columns: 1.6fr 0.8fr 0.8fr;
    }
    .footer-cta {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .footer-top {
      grid-template-columns: 1.5fr 0.8fr 0.8fr 1.2fr;
      align-items: start;
    }
    .footer-cta {
      grid-column: auto;
    }
  }
</style>
