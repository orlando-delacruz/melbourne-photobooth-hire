---
import type { NavItem } from "./islands/MobileNav";
import MobileNav from "./islands/MobileNav";
import { ENQUIRY_HREF } from "../lib/navigation";

interface Props {
  items: NavItem[];
  currentPath: string;
  brandName: string;
}
const { items, currentPath, brandName } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      {brandName}
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="header-cta" href={ENQUIRY_HREF}>
      Enquire now
    </a>
    <div class="mobile-nav">
      <MobileNav
        items={items}
        currentPath={currentPath}
        ctaHref={ENQUIRY_HREF}
        client:media="(max-width: 1023px)"
      />
    </div>
  </div>
</header>
<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
  }
  .brand {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-right: auto;
  }
  .desktop-nav ul {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    color: var(--color-text);
    text-decoration: none;
  }
  .desktop-nav a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
  }
  .header-cta {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: var(--radius-sm);
    padding: var(--space-2xs) var(--space-sm);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 1023px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
