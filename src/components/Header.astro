---
import type { NavItem } from "./islands/MobileNav";
import MobileNav from "./islands/MobileNav";
import { ENQUIRY_HREF } from "../lib/navigation";

interface Props {
  items: NavItem[];
  currentPath: string;
  brandName: string;
}
const { items, currentPath, brandName } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      {brandName}
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {items.map((item) => (
          <li>
            <a
              class:list={["nav-link", { "nav-link--current": currentPath === item.href }]}
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="header-cta" href={ENQUIRY_HREF}>
      Enquire now
    </a>
    <div class="mobile-nav">
      <MobileNav
        items={items}
        currentPath={currentPath}
        ctaHref={ENQUIRY_HREF}
        client:media="(max-width: 1023px)"
      />
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(23, 18, 12, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(230, 206, 138, 0.16);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    color: var(--color-on-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
    margin-right: auto;
  }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-xs);
    color: var(--color-on-ink-secondary);
    font-weight: 500;
    font-size: var(--text-small);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--motion-quick) var(--ease-default);
  }
  .nav-link:hover {
    color: var(--color-on-ink);
  }
  .nav-link--current {
    color: var(--color-on-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent-on-dark);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-sm);
    background: var(--color-accent-on-dark);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--motion-quick) var(--ease-default),
      box-shadow var(--motion-quick) var(--ease-default);
  }
  .header-cta:hover {
    transform: translateY(-1px);
    box-shadow: var(--elevation-1);
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 1023px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
