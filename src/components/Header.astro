---
import MobileNav from "./MobileNav.astro";
import type { NavItem } from "../lib/navigation";
import type { SiteSettingsContent } from "../lib/cms/types";
import { ENQUIRY_HREF } from "../lib/navigation";
import { imageSrcSet } from "../lib/images";

interface Props {
  items: NavItem[];
  currentPath: string;
  initialSettings: SiteSettingsContent;
}
const { items, currentPath, initialSettings } = Astro.props;
const logo = initialSettings.logo;
// CMS logo variants (320w when stored at 512w) let DPR1 screens skip the full
// file; DPR2+ still picks the full file, so no sharpness loss.
const logoSrcSet = logo ? imageSrcSet(logo) : undefined;
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" data-live-section="header-brand">
      {logo?.src ? (
        <img
          class="brand-logo"
          src={logo.src}
          srcset={logoSrcSet}
          sizes={logoSrcSet ? "(max-width: 479px) 152px, 192px" : undefined}
          alt={logo.alt || initialSettings.brandName}
          width={logo.width}
          height={logo.height}
          decoding="async"
        />
      ) : null}
      <span class="brand-mark" aria-hidden="true">
        <svg
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
          <circle cx="12" cy="12" r="3.4" />
          <path d="M7.5 5.5 9 3.2h6l1.5 2.3" />
        </svg>
      </span>
      <span class="brand-name">{initialSettings.brandName}</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {items.map((item) => (
          <li>
            <a
              class:list={["nav-link", { "nav-link--current": currentPath === item.href }]}
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="header-cta" href={ENQUIRY_HREF} data-ga-cta="true" data-ga-location="header">
      <span>Book Now</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </svg>
    </a>
    <div class="mobile-nav">
      <MobileNav
        items={items}
        currentPath={currentPath}
        ctaHref={ENQUIRY_HREF}
        client:media="(max-width: 1023px)"
      />
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const header = document.querySelector("[data-site-header]");
    if (!header) return;
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-header-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--color-header-border);
    box-shadow: 0 18px 44px -24px transparent;
    transition:
      background-color var(--motion-settled) var(--ease-default),
      border-color var(--motion-settled) var(--ease-default),
      box-shadow var(--motion-settled) var(--ease-default);
  }
  .site-header.is-scrolled {
    background: var(--color-header-bg-scrolled);
    border-bottom-color: var(--color-header-border);
    box-shadow: 0 18px 44px -20px var(--color-header-shadow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-right: auto;
    color: var(--color-ink);
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    color: var(--color-accent);
    transition: transform var(--motion-settled) var(--ease-default);
  }
  /* Built-in fallback mark scales with the enlarged navbar logo. */
  .brand-mark svg {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
  }
  .brand:hover .brand-mark {
    transform: rotate(-6deg);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-xs);
    color: var(--color-ink-soft);
    font-weight: 500;
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: var(--space-xs);
    right: var(--space-xs);
    bottom: 10px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-settled) var(--ease-default);
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link--current {
    color: var(--color-ink);
    font-weight: 600;
    background: var(--color-accent-wash);
    border-radius: var(--radius-sm);
  }
  .nav-link--current::after {
    transform: scaleX(1);
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: 0 var(--space-sm) 0 var(--space-md);
    background: var(--color-coral);
    color: var(--color-on-coral);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--motion-quick) var(--ease-default),
      background-color var(--motion-quick) var(--ease-default),
      box-shadow var(--motion-quick) var(--ease-default);
  }
  .header-cta svg {
    transition: transform var(--motion-quick) var(--ease-default);
  }
  .header-cta:hover {
    transform: translateY(-1px);
    background: var(--color-coral-strong);
    box-shadow: var(--elevation-1);
  }
  .header-cta:hover svg {
    transform: translateX(2px);
  }
  .header-cta:active:not(:disabled) {
    transform: translateY(0) scale(0.99);
  }
  .site-header :focus-visible {
    outline-color: var(--color-focus);
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 1023px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    /* The Enquire CTA stays visible beside the menu trigger. */
  }
  /* Compact screens: tighten spacing and hide the CTA arrow so the brand,
     CTA, and menu trigger fit without crowding. */
  @media (max-width: 479px) {
    .header-inner {
      gap: var(--space-xs);
    }
    .brand-mark svg {
      width: 2.5rem;
      height: 2.5rem;
    }
    .header-cta {
      padding: 0 var(--space-sm);
    }
    .header-cta svg {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-link::after,
    .header-cta,
    .header-cta svg,
    .brand-mark {
      transition: none;
    }
    .header-cta:hover,
    .header-cta:active:not(:disabled) {
      transform: none;
    }
  }
</style>
