---
// Booth page cross-links (refined trail below the booth sections).
//
// Single source for the gallery/services trail rendered on every dedicated
// booth page: an editorial lead line plus two arrow links under a champagne
// hairline. Deliberately quieter than the enquiry band below it — secondary
// navigation, not a competing call to action.
---
<nav class="booth-crosslinks" aria-label="Related pages">
  <p class="booth-crosslinks-lead">Want to see the setup?</p>
  <ul>
    <li>
      <a href="/gallery">
        <span>Browse the event gallery</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </li>
    <li>
      <a href="/services">
        <span>Compare all photobooth services</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </li>
  </ul>
</nav>
<style>
  .booth-crosslinks {
    position: relative;
    max-width: 44rem;
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-lg);
    text-align: center;
  }
  .booth-crosslinks::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-line),
      transparent
    );
    pointer-events: none;
  }
  .booth-crosslinks-lead {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead);
    color: var(--color-ink);
  }
  .booth-crosslinks ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
  }
  .booth-crosslinks a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding-block: 0.35rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
  }
  .booth-crosslinks a svg {
    transition: transform var(--motion-quick) var(--ease-default);
  }
  .booth-crosslinks a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .booth-crosslinks a:hover svg {
    transform: translateX(3px);
  }
  .booth-crosslinks a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .booth-crosslinks a,
    .booth-crosslinks a svg {
      transition: none;
    }
    .booth-crosslinks a:hover svg {
      transform: none;
    }
  }
</style>
