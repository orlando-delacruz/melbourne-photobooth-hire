---
import Button from "./Button.astro";
import Reveal from "./islands/Reveal";

interface Stat {
  value: string;
  label: string;
  icon?: "camera" | "clock" | "qrcode";
}

interface Props {
  eyebrow?: string;
  headline: string;
  supporting: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  backgroundSrc?: string;
  backgroundAlt?: string;
  stats?: Stat[];
  scrollHref?: string;
  scrollLabel?: string;
}
const {
  eyebrow = "Melbourne photobooth hire for every event",
  headline,
  supporting,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  backgroundSrc,
  backgroundAlt,
  stats = [],
  scrollHref,
  scrollLabel = "Scroll",
} = Astro.props;

function heroIconSvg(name: string, size = 18): string {
  const paths: Record<string, string> = {
    camera:
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
    clock:
      '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    qrcode:
      '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h7v7h-7z"/>',
  };
  const inner = paths[name] ?? "";
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
}
---

<section
  class="hero"
  aria-labelledby="page-title"
>
  {backgroundSrc ? (
    <div
      class="hero-bg"
      style={`background-image: url('${backgroundSrc}')`}
      aria-hidden="true"
    />
  ) : null}
  <div class="hero-inner">
    {backgroundAlt ? <span class="sr-only">{backgroundAlt}</span> : null}
    <div class="container">
      <div class="hero-copy">
        <Reveal client:load mode="mount" delay={0.05}>
          <p class="hero-eyebrow">{eyebrow}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.13}>
          <h1 id="page-title" class="hero-headline">
            {headline}
          </h1>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.22}>
          <p class="hero-lede">{supporting}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.3}>
          <p class="hero-ctas">
            <Button href={primaryHref} variant="primary" tone="dark">
              {primaryLabel}
            </Button>
            {secondaryHref && secondaryLabel ? (
              <Button href={secondaryHref} variant="secondary" tone="dark">
                {secondaryLabel}
              </Button>
            ) : null}
          </p>
        </Reveal>
        {stats.length > 0 ? (
          <Reveal client:load mode="mount" delay={0.38}>
            <dl class="hero-stats">
              {stats.map((stat) => (
                <div class="hero-stat">
                  <dt class="hero-stat-value" set:html={`${stat.icon ? heroIconSvg(stat.icon) : ""}${stat.value}`} />
                  <dd class="hero-stat-label">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </Reveal>
        ) : null}
      </div>
    </div>
  </div>
  {scrollHref ? (
    <a class="hero-scroll" href={scrollHref}>
      <span class="sr-only">{scrollLabel}</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </a>
  ) : null}
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    width: auto;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    display: flex;
    align-items: center;
    min-height: min(40rem, 92svh);
    padding-block: clamp(3.5rem, 10vw, 7rem);
    border-bottom: 1px solid rgba(230, 206, 138, 0.16);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform-origin: center;
    animation: hero-bg-settle 2.2s var(--ease-default) both;
  }
  @keyframes hero-bg-settle {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-scrim);
    pointer-events: none;
    z-index: 1;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(23, 18, 12, 0.92) 0%,
        rgba(23, 18, 12, 0.62) 50%,
        rgba(23, 18, 12, 0.18) 76%,
        rgba(23, 18, 12, 0.4) 100%
      ),
      linear-gradient(
        180deg,
        rgba(23, 18, 12, 0) 58%,
        rgba(23, 18, 12, 0.6) 84%,
        rgba(23, 18, 12, 0.9) 100%
      );
    pointer-events: none;
    z-index: 2;
  }
  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }
  .hero-copy {
    max-width: var(--text-max-width);
  }
  .hero-eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--color-accent-on-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    letter-spacing: 0.02em;
  }
  .hero-headline {
    margin: 0 0 var(--space-sm);
    color: var(--color-on-ink);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .hero-lede {
    margin: 0 0 var(--space-md);
    color: var(--color-on-ink-secondary);
    font-size: clamp(1.1875rem, 1.6vw, 1.375rem);
    font-weight: 400;
    max-width: 34rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-lg);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
  }
  .hero-stat {
    min-width: 9rem;
    padding: 0 var(--space-sm);
    border-left: 1px solid rgba(230, 206, 138, 0.32);
  }
  .hero-stat:first-child {
    padding-left: 0;
    border-left: none;
  }
  .hero-stat-value {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-on-ink);
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 500;
  }
  .hero-stat-value :global(svg) {
    color: var(--color-accent-on-dark);
    flex-shrink: 0;
  }
  .hero-stat-label {
    margin: 0;
    color: var(--color-on-ink-secondary);
    font-size: var(--text-small);
  }
  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--color-accent-on-dark);
    text-decoration: none;
    transition: color var(--motion-quick) var(--ease-default);
    z-index: 4;
  }
  .hero-scroll:hover,
  .hero-scroll:focus-visible {
    color: var(--color-on-ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 639px) {
    .hero {
      min-height: min(38rem, 94svh);
    }
    .hero-bg {
      background-position: center 32%;
    }
    .hero::after {
      background:
        linear-gradient(
          180deg,
          rgba(23, 18, 12, 0.55) 0%,
          rgba(23, 18, 12, 0.78) 40%,
          rgba(23, 18, 12, 0.94) 78%,
          rgba(23, 18, 12, 0.98) 100%
        );
    }
  }
</style>
