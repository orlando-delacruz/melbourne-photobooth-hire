---
import Button from "./Button.astro";
import Reveal from "./islands/Reveal";

interface Stat {
  value: string;
  label: string;
  icon?: "camera" | "clock" | "qrcode";
}

interface Props {
  eyebrow?: string;
  headline: string;
  supporting: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  backgroundSrc?: string;
  backgroundAlt?: string;
  stats?: Stat[];
  scrollHref?: string;
  scrollLabel?: string;
}
const {
  eyebrow = "Melbourne photobooth hire for every event",
  headline,
  supporting,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  backgroundSrc,
  backgroundAlt,
  stats = [],
  scrollHref,
  scrollLabel = "Scroll",
} = Astro.props;

function heroIconSvg(name: string, size = 18): string {
  const paths: Record<string, string> = {
    camera:
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
    clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    qrcode:
      '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h7v7h-7z"/>',
  };
  const inner = paths[name] ?? "";
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
}
---

<section class="hero on-dark" aria-labelledby="page-title">
  {backgroundSrc ? (
    <div class="hero-bg" style={`background-image: url('${backgroundSrc}')`} aria-hidden="true" />
  ) : null}
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-inner">
    {backgroundAlt ? <span class="sr-only">{backgroundAlt}</span> : null}
    <div class="container">
      <div class="hero-copy">
        <Reveal client:load mode="mount" delay={0.05}>
          <p class="hero-eyebrow eyebrow eyebrow--rule">{eyebrow}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.14}>
          <h1 id="page-title" class="hero-headline">
            {headline}
          </h1>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.24}>
          <p class="hero-lede">{supporting}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.33}>
          <p class="hero-ctas">
            <Button href={primaryHref} variant="primary" tone="dark" size="lg" arrow>
              {primaryLabel}
            </Button>
            {secondaryHref && secondaryLabel ? (
              <Button href={secondaryHref} variant="secondary" tone="dark" size="lg">
                {secondaryLabel}
              </Button>
            ) : null}
          </p>
        </Reveal>
        {stats.length > 0 ? (
          <Reveal client:load mode="mount" delay={0.42}>
            <dl class="hero-stats">
              {stats.map((stat) => (
                <div class="hero-stat">
                  <dt
                    class="hero-stat-value"
                    set:html={`${stat.icon ? heroIconSvg(stat.icon) : ""}${stat.value}`}
                  />
                  <dd class="hero-stat-label">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </Reveal>
        ) : null}
      </div>
    </div>
  </div>
  {scrollHref ? (
    <a class="hero-scroll" href={scrollHref}>
      <span class="sr-only">{scrollLabel}</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  ) : null}
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: auto;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background-color: var(--color-ink-deep);
    color: var(--color-on-ink);
    display: flex;
    align-items: center;
    min-height: 44rem;
    min-height: min(44rem, 96svh);
    padding-block: clamp(4.5rem, 11vw, 8rem);
    border-bottom: 1px solid var(--color-ink-hairline);
  }
  .hero-bg {
    position: absolute;
    inset: -2% 0;
    background-size: cover;
    background-position: center;
    transform-origin: center;
    animation: hero-bg-settle 2.4s var(--ease-default) both;
    z-index: -3;
  }
  @keyframes hero-bg-settle {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }
  /* Base wash + directional gradient + bottom vignette, on one layer. */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgba(13, 9, 6, 0.94) 0%,
        rgba(13, 9, 6, 0.7) 46%,
        rgba(13, 9, 6, 0.24) 74%,
        rgba(13, 9, 6, 0.5) 100%
      ),
      linear-gradient(
        180deg,
        rgba(13, 9, 6, 0.2) 0%,
        rgba(13, 9, 6, 0.72) 86%,
        rgba(13, 9, 6, 0.96) 100%
      ),
      radial-gradient(120% 120% at 85% 0%, rgba(230, 206, 138, 0.14), transparent 55%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-copy {
    max-width: 46rem;
  }
  .hero-eyebrow {
    color: var(--color-accent-on-dark);
  }
  .hero-headline {
    margin: var(--space-md) 0 var(--space-md);
    color: var(--color-on-ink);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }
  .hero-lede {
    margin: 0 0 var(--space-lg);
    color: var(--color-on-ink-secondary);
    font-size: var(--text-lead);
    font-weight: 400;
    max-width: 36rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-lg);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) 0;
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ink-hairline);
  }
  .hero-stat {
    min-width: 10rem;
    padding: 0 var(--space-md);
    border-left: 1px solid var(--color-ink-hairline);
  }
  .hero-stat:first-child {
    padding-left: 0;
    border-left: none;
  }
  .hero-stat-value {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-on-ink);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
  }
  .hero-stat-value :global(svg) {
    color: var(--color-accent-on-dark);
    flex-shrink: 0;
  }
  .hero-stat-label {
    margin: var(--space-3xs) 0 0;
    color: var(--color-on-ink-faint);
    font-size: var(--text-small);
  }
  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    z-index: 2;
  }
  .hero-scroll-line {
    display: block;
    width: 1px;
    height: 42px;
    background: linear-gradient(180deg, transparent, var(--color-accent-on-dark));
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 639px) {
    .hero {
      min-height: 34rem;
      min-height: min(34rem, 84svh);
      padding-block: clamp(2.75rem, 8vw, 4rem);
    }
    .hero-bg {
      background-position: center 32%;
    }
    .hero-veil {
      background:
        linear-gradient(
          180deg,
          rgba(13, 9, 6, 0.5) 0%,
          rgba(13, 9, 6, 0.82) 42%,
          rgba(13, 9, 6, 0.96) 84%,
          rgba(13, 9, 6, 1) 100%
        ),
        radial-gradient(140% 80% at 80% 8%, rgba(230, 206, 138, 0.14), transparent 60%);
    }
    .hero-headline {
      margin: var(--space-sm) 0 var(--space-sm);
    }
    .hero-lede {
      margin-bottom: var(--space-md);
    }
    /* Stack the CTAs full width so they never wrap unevenly. */
    .hero-ctas {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      margin-bottom: var(--space-md);
    }
    .hero-ctas :global(.button) {
      width: 100%;
      justify-content: center;
    }
    /* Stats become a tidy three-up row with a single top rule. */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2xs);
      padding-top: var(--space-sm);
      border-top: 1px solid var(--color-ink-hairline);
    }
    .hero-stat {
      min-width: 0;
      padding: 0;
      border-left: 0;
    }
    .hero-stat-value {
      font-size: var(--text-h3);
      gap: var(--space-3xs);
    }
    .hero-stat-label {
      font-size: var(--text-small);
    }
    .hero-scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }
</style>
