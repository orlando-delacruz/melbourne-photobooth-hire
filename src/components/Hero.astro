---
import Button from "./Button.astro";
import Reveal from "./islands/Reveal";

interface Stat {
  value: string;
  label: string;
  icon?: "camera" | "clock" | "qrcode" | "star";
}

interface Props {
  eyebrow?: string;
  headline: string;
  supporting: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  backgroundSrc?: string;
  backgroundAlt?: string;
  stats?: Stat[];
  scrollHref?: string;
  scrollLabel?: string;
}
const {
  eyebrow = "Melbourne photobooth hire for every event",
  headline,
  supporting,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  backgroundSrc,
  backgroundAlt,
  stats = [],
  scrollHref,
  scrollLabel = "Scroll",
} = Astro.props;

function heroIconSvg(name: string, size = 18): string {
  const paths: Record<string, string> = {
    camera:
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
    clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    qrcode:
      '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h7v7h-7z"/>',
    star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  };
  const inner = paths[name] ?? "";
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
}
---

<section class="hero" aria-labelledby="page-title">
  {backgroundSrc ? (
    <img
      class="hero-bg"
      src={backgroundSrc}
      alt=""
      width="1600"
      height="1200"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
    />
  ) : null}
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-inner">
    {backgroundAlt ? <span class="sr-only">{backgroundAlt}</span> : null}
    <div class="container">
      <div class="hero-copy">
        <Reveal client:load mode="mount" delay={0.05}>
          <p class="hero-eyebrow eyebrow eyebrow--rule">{eyebrow}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.14}>
          <h1 id="page-title" class="hero-headline">
            {headline}
          </h1>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.24}>
          <p class="hero-lede">{supporting}</p>
        </Reveal>
        <Reveal client:load mode="mount" delay={0.33}>
          <p class="hero-ctas">
            <Button href={primaryHref} variant="primary" tone="light" size="lg" arrow>
              {primaryLabel}
            </Button>
            {secondaryHref && secondaryLabel ? (
              <Button href={secondaryHref} variant="secondary" tone="light" size="lg">
                {secondaryLabel}
              </Button>
            ) : null}
          </p>
        </Reveal>
        {stats.length > 0 ? (
          <Reveal client:load mode="mount" delay={0.42}>
            <dl class="hero-stats">
              {stats.map((stat) => (
                <div class="hero-stat">
                  <dt
                    class="hero-stat-value"
                    set:html={`${stat.icon ? heroIconSvg(stat.icon) : ""}${stat.value}`}
                  />
                  <dd class="hero-stat-label">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </Reveal>
        ) : null}
      </div>
    </div>
  </div>
  {scrollHref ? (
    <a class="hero-scroll" href={scrollHref}>
      <span class="sr-only">{scrollLabel}</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  ) : null}
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: auto;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background-color: var(--color-ivory-deep);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    min-height: 44rem;
    min-height: min(44rem, 96svh);
    padding-block: clamp(4.5rem, 11vw, 8rem);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-bg {
    position: absolute;
    top: -2%;
    left: 0;
    width: 100%;
    height: 104%;
    object-fit: cover;
    object-position: center;
    transform-origin: center;
    animation: hero-bg-settle 2.4s var(--ease-default) both;
    z-index: -3;
  }
  @keyframes hero-bg-settle {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }
  /* Base wash + directional gradient + bottom vignette, on one layer. */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-ivory) 95%, transparent) 0%,
        color-mix(in srgb, var(--color-ivory) 82%, transparent) 44%,
        color-mix(in srgb, var(--color-ivory) 45%, transparent) 72%,
        color-mix(in srgb, var(--color-ivory) 55%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-ivory) 45%, transparent) 0%,
        color-mix(in srgb, var(--color-ivory) 30%, transparent) 55%,
        color-mix(in srgb, var(--color-ivory) 60%, transparent) 100%
      ),
      radial-gradient(120% 120% at 85% 0%, var(--color-accent-line), transparent 55%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-copy {
    max-width: 46rem;
  }
  .hero-eyebrow {
    color: var(--color-accent-strong);
  }
  .hero-headline {
    margin: var(--space-md) 0 var(--space-md);
    color: var(--color-ink);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }
  .hero-lede {
    margin: 0 0 var(--space-lg);
    color: var(--color-ink-soft);
    font-size: var(--text-lead);
    font-weight: 400;
    max-width: 36rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-lg);
  }
  /* One fixed row that always fits: a single-column flow grid gives every
     card an equal share, so any stat count stays on one line without
     wrapping or sideways scroll (mirror of live.css). */
  .hero-stats {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(0.5rem, 1.1vw, 0.85rem);
    max-width: 34rem;
    margin: var(--space-md) 0 0;
    padding: 0;
  }
  /* Individual frosted-glass stat cards (mirror of live.css). */
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    min-width: 0;
    padding: clamp(0.7rem, 1.4vw, 1rem) clamp(0.6rem, 1.1vw, 1rem);
    text-align: center;
    background: color-mix(in srgb, var(--color-surface) 62%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
  }
  .hero-stat-value {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.45rem);
    font-weight: 600;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .hero-stat-value :global(svg) {
    color: var(--color-accent-strong);
    flex-shrink: 0;
  }
  .hero-stat-label {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: clamp(0.72rem, 0.95vw, 0.85rem);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    z-index: 2;
  }
  .hero-scroll-line {
    display: block;
    width: 1px;
    height: 42px;
    background: linear-gradient(180deg, transparent, var(--color-accent-strong));
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 639px) {
    .hero {
      min-height: 34rem;
      min-height: min(34rem, 84svh);
      padding-block: clamp(2.75rem, 8vw, 4rem);
    }
    .hero-bg {
      object-position: center 32%;
    }
    .hero-veil {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-ivory) 90%, transparent) 0%,
          color-mix(in srgb, var(--color-ivory) 75%, transparent) 42%,
          color-mix(in srgb, var(--color-ivory) 85%, transparent) 80%,
          color-mix(in srgb, var(--color-ivory) 93%, transparent) 100%
        ),
        radial-gradient(140% 80% at 80% 8%, var(--color-accent-line), transparent 60%);
    }
    .hero-headline {
      margin: var(--space-sm) 0 var(--space-sm);
    }
    .hero-lede {
      margin-bottom: var(--space-md);
    }
    /* Stack the CTAs full width so they never wrap unevenly. */
    .hero-ctas {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      margin-bottom: var(--space-md);
    }
    .hero-ctas :global(.button) {
      width: 100%;
      justify-content: center;
    }
    /* Stats stay in a single row on phones: equal columns that share the
       width, with a comfortable column floor; if enough stats are added to
       exceed the row the strip scrolls sideways instead of crushing labels. */
    .hero-stats {
      gap: 0.4rem;
      max-width: none;
      margin-top: var(--space-sm);
    }
    .hero-stat {
      gap: 0.15rem;
      padding: 0.6rem 0.5rem;
      border-radius: var(--radius-md);
    }
    .hero-stat-value {
      font-size: clamp(0.95rem, 4.2vw, 1.2rem);
      gap: 0.25rem;
    }
    .hero-stat-value svg {
      width: 13px;
      height: 13px;
    }
    .hero-stat-label {
      font-size: clamp(0.64rem, 2.6vw, 0.75rem);
      line-height: 1.25;
    }
    .hero-scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }
</style>
