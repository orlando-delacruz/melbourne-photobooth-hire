---
/**
 * Homepage hero (DEC-050).
 *
 * Static, server-rendered markup with no client JavaScript — the previous
 * React island delayed the hero paint (LCP) until hydration, which is the
 * opposite of what the hero needs. Live copy updates are delivered by the
 * shared vanilla chrome runtime via `data-live-section`. Styling comes from
 * styles/live.css (loaded globally by BaseLayout).
 */
import Button from "./Button.astro";
import { cmsIconMarkup } from "../lib/ssrIcon";
import type { HeroStat } from "../lib/cms/types";

interface Props {
  eyebrow?: string;
  headline: string;
  supporting: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  backgroundSrc?: string;
  backgroundAlt?: string;
  stats?: HeroStat[];
  scrollHref?: string;
  scrollLabel?: string;
}
const {
  eyebrow = "Melbourne photobooth hire for every event",
  headline,
  supporting,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  backgroundSrc,
  backgroundAlt,
  stats = [],
  scrollHref,
  scrollLabel = "Scroll",
} = Astro.props;
---

<section
  class="hero"
  aria-labelledby="page-title"
  data-live-section="home-hero"
  data-ga-location="hero"
>
  {backgroundSrc ? (
    <img
      class="hero-bg"
      src={backgroundSrc}
      alt=""
      width="1600"
      height="1200"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
    />
  ) : null}
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-inner">
    {backgroundAlt ? <span class="sr-only">{backgroundAlt}</span> : null}
    <div class="container">
      <div class="hero-copy">
        <p class="hero-eyebrow eyebrow eyebrow--rule">{eyebrow}</p>
        <h1 id="page-title" class="hero-headline">
          {headline}
        </h1>
        <p class="hero-lede">{supporting}</p>
        <p class="hero-ctas">
          <Button href={primaryHref} variant="primary" tone="light" size="lg" arrow>
            {primaryLabel}
          </Button>
          {secondaryHref && secondaryLabel ? (
            <Button href={secondaryHref} variant="secondary" tone="light" size="lg">
              {secondaryLabel}
            </Button>
          ) : null}
        </p>
        {stats.length > 0 ? (
          <dl class="hero-stats">
            {stats.map((stat) => (
              <div class="hero-stat">
                <dt class="hero-stat-value">
                  <Fragment set:html={cmsIconMarkup(stat.icon, 18)} />
                  {stat.value}
                </dt>
                <dd class="hero-stat-label">{stat.label}</dd>
              </div>
            ))}
          </dl>
        ) : null}
      </div>
    </div>
  </div>
  {scrollHref ? (
    <a class="hero-scroll" href={scrollHref}>
      <span class="sr-only">{scrollLabel}</span>
      <span class="hero-scroll-line" aria-hidden="true" />
    </a>
  ) : null}
</section>
