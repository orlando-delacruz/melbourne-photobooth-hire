---
// Admin shell: sidebar navigation, topbar and content region. The drawer is
// toggled by a small inline script (same pattern as the public header), so
// the chrome needs no client-side framework.
import {
  ADMIN_DASHBOARD,
  ADMIN_EXTERNAL_ICON,
  CMS_SECTIONS,
  MODULE_SECTIONS,
  INQUIRIES_SECTION,
  SEO_SECTION,
  SETTINGS_SECTION,
} from "./sections";

interface Props {
  /** Active nav key: "dashboard" or a CMS section key. */
  active: string;
  /** Short title shown in the topbar. */
  title: string;
  /** Heading shown with the description in the page content. Defaults to the title. */
  heading?: string;
  /** Short context line shown under the content heading. */
  lede?: string;
  /** Public page URL for the "view page" link. Omitted for the dashboard. */
  publicHref?: string | null;
}

const { active, title, heading, lede, publicHref } = Astro.props;

/** The Pages group renders expanded when the current route manages a page. */
const pagesActive = CMS_SECTIONS.some((section) => section.key === active);

const dashboardIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`;
const menuIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`;
const closeIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`;
---

<div class="ad-shell" data-admin-shell>
  <div class="ad-scrim" data-admin-scrim aria-hidden="true"></div>
  <aside class="ad-sidebar" aria-label="Content sections">
    <div class="ad-brand">
      <span class="ad-brand-mark" aria-hidden="true" set:html={dashboardIcon} />
      <span class="ad-brand-text">
        <strong>Melbourne Photobooth Hire</strong>
        <span>Content admin</span>
      </span>
    </div>
    <nav aria-label="Admin">
      <p class="ad-nav-caption">Manage</p>
      <ul class="ad-nav">
        <li>
          <a
            href={ADMIN_DASHBOARD.href}
            class:list={["ad-nav-link", { "ad-nav-link--current": active === "dashboard" }]}
            aria-current={active === "dashboard" ? "page" : undefined}
          >
            <span class="ad-nav-icon" aria-hidden="true" set:html={ADMIN_DASHBOARD.icon} />
            {ADMIN_DASHBOARD.label}
          </a>
        </li>
        <li>
          <a
            href={INQUIRIES_SECTION.href}
            class:list={[
              "ad-nav-link",
              { "ad-nav-link--current": active === INQUIRIES_SECTION.key },
            ]}
            aria-current={active === INQUIRIES_SECTION.key ? "page" : undefined}
          >
            <span class="ad-nav-icon" aria-hidden="true" set:html={INQUIRIES_SECTION.icon} />
            {INQUIRIES_SECTION.label}
          </a>
        </li>
      </ul>
      <div class="ad-nav-group" data-admin-nav-group data-open={pagesActive ? "true" : "false"}>
        <button
          type="button"
          class:list={["ad-nav-toggle", { "ad-nav-toggle--active": pagesActive }]}
          data-admin-nav-toggle
          aria-expanded={pagesActive ? "true" : "false"}
          aria-controls="admin-nav-pages"
        >
          <span>Pages</span>
          <svg
            class="ad-nav-chevron"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            data-admin-nav-chevron
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <ul class="ad-nav" id="admin-nav-pages">
          {CMS_SECTIONS.map((section) => (
            <li>
              <a
                href={section.href}
                class:list={["ad-nav-link", { "ad-nav-link--current": active === section.key }]}
                aria-current={active === section.key ? "page" : undefined}
              >
                <span class="ad-nav-icon" aria-hidden="true" set:html={section.icon} />
                {section.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p class="ad-nav-caption">Modules</p>
      <ul class="ad-nav">
        {MODULE_SECTIONS.map((section) => (
          <li>
            <a
              href={section.href}
              class:list={["ad-nav-link", { "ad-nav-link--current": active === section.key }]}
              aria-current={active === section.key ? "page" : undefined}
            >
              <span class="ad-nav-icon" aria-hidden="true" set:html={section.icon} />
              {section.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="ad-nav-caption">SEO</p>
      <ul class="ad-nav">
        <li>
          <a
            href={SEO_SECTION.href}
            class:list={["ad-nav-link", { "ad-nav-link--current": active === SEO_SECTION.key }]}
            aria-current={active === SEO_SECTION.key ? "page" : undefined}
          >
            <span class="ad-nav-icon" aria-hidden="true" set:html={SEO_SECTION.icon} />
            {SEO_SECTION.label}
          </a>
        </li>
      </ul>
      <p class="ad-nav-caption">Site</p>
      <ul class="ad-nav">
        <li>
          <a
            href={SETTINGS_SECTION.href}
            class:list={[
              "ad-nav-link",
              { "ad-nav-link--current": active === SETTINGS_SECTION.key },
            ]}
            aria-current={active === SETTINGS_SECTION.key ? "page" : undefined}
          >
            <span class="ad-nav-icon" aria-hidden="true" set:html={SETTINGS_SECTION.icon} />
            {SETTINGS_SECTION.label}
          </a>
        </li>
      </ul>
    </nav>
    <p class="ad-sidebar-note">Changes go live after saving and publishing.</p>
  </aside>

  <div class="ad-main">
    <header class="ad-topbar">
      <button
        type="button"
        class="ad-menu-button"
        data-admin-menu
        aria-expanded="false"
        aria-controls="admin-sidebar"
        aria-label="Open navigation"
      >
        <span data-admin-menu-open set:html={menuIcon} />
        <span data-admin-menu-close hidden set:html={closeIcon} />
      </button>
      <div class="ad-topbar-title">
        <h1>{title}</h1>
      </div>
      {publicHref ? (
        <a class="ad-view-link" href={publicHref} target="_blank" rel="noopener noreferrer">
          View page
          <span aria-hidden="true" set:html={ADMIN_EXTERNAL_ICON} />
        </a>
      ) : null}
    </header>
    <main class="ad-content" id="main">
      {lede ? (
        <div class="ad-page-head">
          <h2>{heading ?? title}</h2>
          <p>{lede}</p>
        </div>
      ) : null}
      <slot />
    </main>
  </div>
</div>

<script is:inline>
  (() => {
    const shell = document.querySelector("[data-admin-shell]");
    const button = document.querySelector("[data-admin-menu]");
    const scrim = document.querySelector("[data-admin-scrim]");
    if (!shell || !button || !(button instanceof HTMLButtonElement)) return;
    const openIcon = button.querySelector("[data-admin-menu-open]");
    const closeIcon = button.querySelector("[data-admin-menu-close]");
    const setOpen = (open) => {
      shell.classList.toggle("ad-shell--nav-open", open);
      button.setAttribute("aria-expanded", open ? "true" : "false");
      button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      if (openIcon instanceof HTMLElement) openIcon.hidden = open;
      if (closeIcon instanceof HTMLElement) closeIcon.hidden = !open;
    };
    button.addEventListener("click", () => {
      setOpen(!shell.classList.contains("ad-shell--nav-open"));
    });
    if (scrim) scrim.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    const navGroup = document.querySelector("[data-admin-nav-group]");
    const navToggle = document.querySelector("[data-admin-nav-toggle]");
    if (navGroup instanceof HTMLElement && navToggle instanceof HTMLButtonElement) {
      navToggle.addEventListener("click", () => {
        const open = navGroup.getAttribute("data-open") !== "true";
        navGroup.setAttribute("data-open", open ? "true" : "false");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
  })();
</script>
