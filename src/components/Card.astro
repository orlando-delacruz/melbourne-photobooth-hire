---
import Button from "./Button.astro";

type CardIcon = "camera" | "users" | "video";

interface Props {
  title: string;
  description?: string;
  meta?: string;
  price?: string;
  badge?: string;
  tagline?: string;
  icon?: CardIcon;
  items?: string[];
  highlights?: string[];
  href?: string;
  ctaLabel?: string;
  imageSrc?: string;
  imageAlt?: string;
  tone?: "light" | "dark";
  featured?: boolean;
}
const {
  title,
  description,
  meta,
  price,
  badge,
  tagline,
  icon,
  items = [],
  highlights = [],
  href,
  ctaLabel,
  imageSrc,
  imageAlt,
  tone = "light",
  featured = false,
} = Astro.props;

const priceParts = price ? price.trim().split(/\s+/) : [];
const priceAmount = priceParts[0] ?? "";
const priceSuffix = priceParts.slice(1).join(" ");

function iconSvg(name: string, size = 20): string {
  const paths: Record<string, string> = {
    camera:
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
    users:
      '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    video: '<path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
  };
  const inner = paths[name] ?? "";
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
}

const starSvg = `<svg class="card-badge-star" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>`;
---

<article class:list={["card", `card--${tone}`, { "card--featured": featured }]}>
  {imageSrc ? (
    <div class="card-media">
      <img class="card-image" src={imageSrc} alt={imageAlt ?? ""} loading="lazy" decoding="async" />
    </div>
  ) : null}
  <div class="card-body">
    {icon || badge ? (
      <div class="card-head">
        {icon ? <span class="card-icon" set:html={iconSvg(icon)} /> : null}
        {badge ? (
          <p class="card-badge">
            {featured ? <Fragment set:html={starSvg} /> : null}
            <span>{badge}</span>
          </p>
        ) : null}
      </div>
    ) : null}
    <h3 class="card-title">{title}</h3>
    {tagline ? <p class="card-tagline">{tagline}</p> : null}
    {meta ? <p class="card-meta">{meta}</p> : null}
    {price ? (
      <p class="card-price">
        <span class="card-price-amount">{priceAmount}</span>
        {priceSuffix ? <span class="card-price-suffix">{priceSuffix}</span> : null}
      </p>
    ) : null}
    {description ? <p class="card-description">{description}</p> : null}
    {highlights.length > 0 ? (
      <ul class="card-list card-highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : null}
    {items.length > 0 ? (
      <ul class="card-list card-inclusions">
        {items.map((item) => (
          <li>
            <svg
              class="card-check"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m5 12.5 4.5 4.5L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    ) : null}
    {href && ctaLabel ? (
      <p class="card-cta">
        <Button href={href} variant="secondary" tone={featured ? "dark" : tone} arrow>
          {ctaLabel}
        </Button>
      </p>
    ) : null}
  </div>
</article>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--motion-settled) var(--ease-default),
      box-shadow var(--motion-settled) var(--ease-default),
      border-color var(--motion-settled) var(--ease-default);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
    box-shadow: var(--elevation-2);
  }
  .card-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-ink-raised);
  }
  .card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(13, 9, 6, 0.55) 100%);
    opacity: 0.9;
    pointer-events: none;
  }
  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 700ms var(--ease-default),
      filter 700ms var(--ease-default);
  }
  .card:hover .card-image {
    transform: scale(1.05);
    filter: brightness(1.04) saturate(1.03);
  }
  .card-body {
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
    flex-shrink: 0;
  }
  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin: 0;
    padding: 0.35em 0.75em;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-accent-strong);
    background: transparent;
    font-weight: 600;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .card-title {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-h3);
    font-weight: 500;
  }
  .card-tagline {
    margin: -0.35rem 0 var(--space-sm);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-body);
    font-weight: 400;
  }
  .card-meta {
    margin: 0 0 var(--space-2xs);
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .card-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }
  .card-price-amount {
    color: var(--color-ink);
    font-size: var(--text-title);
    line-height: 1;
  }
  .card-price-suffix {
    color: var(--color-ink-faint);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .card-description {
    margin: 0 0 var(--space-md);
    color: var(--color-ink-soft);
  }
  .card-list {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .card-inclusions li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs);
    align-items: start;
    color: var(--color-ink-soft);
  }
  .card-check {
    color: var(--color-accent);
    margin-top: 0.32em;
    flex-shrink: 0;
  }
  .card-highlights {
    gap: var(--space-xs);
  }
  .card-highlights li {
    position: relative;
    padding-left: var(--space-sm);
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
  .card-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .card-cta {
    margin: auto 0 0;
    padding-top: var(--space-xs);
  }

  /* Dark variant (homepage "event noir" cards) */
  .card--dark {
    background: linear-gradient(180deg, rgba(244, 238, 224, 0.045), rgba(244, 238, 224, 0.01));
    border-color: var(--color-ink-hairline);
    color: var(--color-on-ink);
  }
  .card--dark:hover {
    border-color: var(--color-ink-hairline-strong);
  }
  .card--dark .card-title,
  .card--dark .card-price {
    color: var(--color-on-ink);
  }
  .card--dark .card-price-amount {
    color: var(--color-on-ink);
  }
  .card--dark .card-price-suffix {
    color: var(--color-on-ink-faint);
  }
  .card--dark .card-meta {
    color: var(--color-on-ink-faint);
  }
  .card--dark .card-description,
  .card--dark .card-inclusions li,
  .card--dark .card-highlights li {
    color: var(--color-on-ink-secondary);
  }
  .card--dark .card-tagline {
    color: var(--color-accent-on-dark);
  }
  .card--dark .card-icon {
    color: var(--color-accent-on-dark);
    border-color: var(--color-ink-hairline-strong);
    background: var(--color-accent-wash);
  }
  .card--dark .card-badge {
    color: var(--color-accent-on-dark);
    border-color: var(--color-ink-hairline-strong);
  }
  .card--dark .card-check {
    color: var(--color-accent-on-dark);
  }
  .card--dark .card-highlights li::before {
    background: var(--color-accent-on-dark);
  }

  /* Featured package: the headliner of the row. */
  .card--featured {
    border-color: var(--color-accent);
    box-shadow:
      0 0 0 1px var(--color-accent),
      var(--elevation-2);
  }
  .card--featured.card--dark {
    border-color: var(--color-accent-on-dark);
    box-shadow:
      0 0 0 1px var(--color-accent-on-dark),
      var(--elevation-3);
  }
  .card--featured.card--dark .card-price-amount {
    color: var(--color-accent-on-dark);
  }
  /* Champagne hairline across the top edge. */
  .card--featured.card--dark::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    z-index: 2;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-on-dark) 22%,
      #fff2c8 50%,
      var(--color-accent-on-dark) 78%,
      transparent
    );
  }
  /* Interior spotlight, kept inside the card's clipped surface. */
  .card--featured.card--dark::after {
    content: "";
    position: absolute;
    inset: -35% -20% auto;
    height: 65%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(60% 100% at 50% 0%, rgba(230, 206, 138, 0.16), transparent 70%);
  }
  .card--featured .card-body {
    position: relative;
    z-index: 1;
  }
  .card--featured .card-badge {
    border-color: transparent;
    background: var(--color-accent-on-dark);
    color: var(--color-ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }
  /* Featured on a light page: a solid "event noir" card that stands apart from
     the standard light cards, with the price highlighted in champagne. */
  .card--featured.card--light {
    background: linear-gradient(180deg, var(--color-surface-dark), var(--color-ink));
    border-color: var(--color-ink-hairline-strong);
    box-shadow: var(--elevation-3);
    color: var(--color-on-ink);
  }
  .card--featured.card--light:hover {
    border-color: var(--color-accent-on-dark);
    box-shadow: var(--elevation-3);
  }
  .card--featured.card--light::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    z-index: 2;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-on-dark) 22%,
      #fff2c8 50%,
      var(--color-accent-on-dark) 78%,
      transparent
    );
  }
  .card--featured.card--light::after {
    content: "";
    position: absolute;
    inset: -35% -20% auto;
    height: 65%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(60% 100% at 50% 0%, rgba(230, 206, 138, 0.16), transparent 70%);
  }
  .card--featured.card--light .card-title,
  .card--featured.card--light .card-price {
    color: var(--color-on-ink);
  }
  .card--featured.card--light .card-meta {
    color: var(--color-on-ink-faint);
  }
  .card--featured.card--light .card-tagline {
    color: var(--color-accent-on-dark);
  }
  .card--featured.card--light .card-description,
  .card--featured.card--light .card-inclusions li,
  .card--featured.card--light .card-highlights li {
    color: var(--color-on-ink-secondary);
  }
  .card--featured.card--light .card-icon {
    color: var(--color-accent-on-dark);
    border-color: var(--color-ink-hairline-strong);
    background: var(--color-accent-wash);
  }
  .card--featured.card--light .card-check {
    color: var(--color-accent-on-dark);
  }
  .card--featured.card--light .card-highlights li::before {
    background: var(--color-accent-on-dark);
  }
  .card--featured.card--light .card-price-amount {
    color: var(--color-accent-on-dark);
  }
  .card--featured.card--light .card-price-suffix {
    color: var(--color-on-ink-faint);
  }

  @media (min-width: 900px) {
    .card--featured {
      transform: translateY(-0.7rem);
    }
    .card--featured:hover {
      transform: translateY(-1.15rem);
    }
  }
  .card--dark .card-media {
    background: var(--color-ink-deep);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-image {
      transition: none;
    }
  }
</style>
