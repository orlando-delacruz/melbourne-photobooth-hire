---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  imageSrc?: string;
  imageAlt?: string;
  /** Draw the champagne rule before the eyebrow. */
  rule?: boolean;
}
const { title, eyebrow, lede, imageSrc, imageAlt, rule = true } = Astro.props;
---

<header class="page-header bleed on-dark">
  {imageSrc ? (
    <>
      <div
        class="page-header__media"
        style={`background-image: url('${imageSrc}')`}
        aria-hidden="true"
      />
      {imageAlt ? <span class="sr-only">{imageAlt}</span> : null}
    </>
  ) : null}
  <div class="page-header__glow" aria-hidden="true"></div>
  <div class="container page-header__inner">
    {eyebrow ? <p class:list={["eyebrow", { "eyebrow--rule": rule }]}>{eyebrow}</p> : null}
    <h1>{title}</h1>
    {lede ? <p class="lede">{lede}</p> : null}
    <slot />
  </div>
</header>
<style>
  .page-header {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--color-ink-hairline);
  }
  .page-header__media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.42;
    z-index: -2;
  }
  .page-header__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 82% 12%, rgba(230, 206, 138, 0.16), transparent 60%),
      linear-gradient(180deg, rgba(13, 9, 6, 0.25) 0%, rgba(13, 9, 6, 0.72) 100%);
  }
  .page-header__inner {
    position: relative;
    max-width: 56rem;
  }
  .page-header h1 {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-on-ink);
  }
  .lede {
    margin: var(--space-sm) 0 0;
    max-width: 44rem;
    color: var(--color-on-ink-secondary);
    font-size: var(--text-lead);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
