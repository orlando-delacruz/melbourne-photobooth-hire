---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  imageSrc?: string;
  imageAlt?: string;
  /** Draw the champagne rule before the eyebrow. */
  rule?: boolean;
}
const { title, eyebrow, lede, imageSrc, imageAlt, rule = true } = Astro.props;
---

<header class="page-header bleed">
  {imageSrc ? (
    <>
      <img
        class="page-header__media"
        src={imageSrc}
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
      {imageAlt ? <span class="sr-only">{imageAlt}</span> : null}
    </>
  ) : null}
  <div class="page-header__glow" aria-hidden="true"></div>
  <div class="container page-header__inner">
    {eyebrow ? <p class:list={["eyebrow", { "eyebrow--rule": rule }]}>{eyebrow}</p> : null}
    <h1>{title}</h1>
    {lede ? <p class="lede">{lede}</p> : null}
    <slot />
  </div>
</header>
<style>
  .page-header {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ivory-deep);
    color: var(--color-ink);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5;
    z-index: -2;
  }
  /* Lighter veil so the header photo reads through. A left-to-right ivory wash
     keeps the copy legible while the right of the image stays visible; a second
     vertical wash softens the top/bottom edges. */
  .page-header__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 82% 12%, var(--color-accent-line), transparent 60%),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-ivory) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-ivory) 62%, transparent) 55%,
        color-mix(in srgb, var(--color-ivory) 38%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-ivory) 30%, transparent) 0%,
        color-mix(in srgb, var(--color-ivory) 50%, transparent) 100%
      );
  }
  .page-header__inner {
    position: relative;
    max-width: 75rem;
  }
  .page-header h1 {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }
  .lede {
    margin: var(--space-sm) 0 0;
    max-width: 44rem;
    color: var(--color-ink-soft);
    font-size: var(--text-lead);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
